# ==============================
# HiRAG runtime configuration
# ==============================

# Required input context file for indexing (.txt or .json list)

# ------------------------------
# Paths configuration
# ------------------------------
GRAPH_NAME=test
CONTEXT_FILE=./data/datasets/test/unique_contexts.json
DATASETS_PATH=./data/datasets
KNOWLEDGE_GRAPH_PATH=./data/graph
GRAPH_VIS_PATH=./data/vis

# HiRAG working directory
WORKING_DIR=./HiRAG/your_work_dir

# ------------------------------
# vLLM / OpenAI-compatible chat
# ------------------------------
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY

# Optional: if empty, model can be auto-discovered from /models
VLLM_CHAT_MODEL=

# ------------------------------
# Embedding configuration
# ------------------------------
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_DIM=384
MAX_TOKEN_SIZE=8192

# HiRAG embedding pipeline tuning
EMBEDDING_BATCH_NUM=6
EMBEDDING_FUNC_MAX_ASYNC=8

# FastEmbed runtime tuning (optional)
FASTEMBED_THREADS=
FASTEMBED_PARALLEL=
FASTEMBED_CACHE_PATH=./data/models/fastembed

# ------------------------------
# Feature flags (0/1)
# ------------------------------
DISABLE_LLM_CACHE=0
DISABLE_HIERACHICAL_MODE=0
DISABLE_NAIVE_RAG=0

# ------------------------------
# Optional query run after index
# ------------------------------
QUERY=
QUERY_MODE=hi

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
