      <data key="d4">8.0</data>
      <data key="d5">"Laboratory hermits are investigators who stimulated growers to acquire the NPK mentality through isolated plant experiments."</data>
      <data key="d6">chunk-f54ae758c012dc186d43caf6a059360a</data>
      <data key="d7">1</data>
    </edge>
