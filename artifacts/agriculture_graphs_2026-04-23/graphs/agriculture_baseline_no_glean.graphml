      <data key="d4">9.0</data>
      <data key="d5">"The publication of 'Our Common Future' (Brundtland Report) signaled the need to operationalize sustainable development."</data>
      <data key="d6">chunk-bec46d177c6336f2fe727e22398abaf6</data>
      <data key="d7">1</data>
    </edge>
