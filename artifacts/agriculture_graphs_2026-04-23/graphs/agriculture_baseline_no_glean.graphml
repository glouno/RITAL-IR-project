      <data key="d6">chunk-a78d99903600ffa6f92d29953bed6a52</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;US CORN REFINERS ASSOCIATION&quot;" target="&quot;GM CORN&quot;">
