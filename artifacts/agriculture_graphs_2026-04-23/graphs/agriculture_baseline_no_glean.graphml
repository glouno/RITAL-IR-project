      <data key="d6">chunk-08ecb691c2f9f13d9852979644924e78</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;CIVIL RIGHTS MOVEMENT&quot;" target="&quot;AMERICAN LIBERALS&quot;">
      <data key="d4">8.0</data>
