      <data key="d6">chunk-f3a9f95df2c28cf16cc0339d5b436227</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE TOOL&quot;" target="&quot;HIVE BODY&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The hive tool is used to separate and slide frames apart within the hive body."</data>
      <data key="d6">chunk-50100ec9bbd638fb693fc24eeb2b3110</data>
