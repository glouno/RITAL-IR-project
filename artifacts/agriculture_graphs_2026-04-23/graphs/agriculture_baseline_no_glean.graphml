    <node id="&quot;SKEPS&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Skeps are domed hives made of twisted straw, used in early beekeeping as a precursor to modern wooden hives."&lt;SEP&gt;"Traditional beehives used prior to the improvements made by Dzierzon, Huber, and Bevan."</data>
      <data key="d2">chunk-c29c8fc62f2aad355ff0f1407fba86a8&lt;SEP&gt;chunk-96f78f364d74eca8b91a5a10f5f9de4b</data>
