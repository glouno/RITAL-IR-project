      <data key="d4">10.0</data>
      <data key="d5">"Dr. Orson K. Miller first described P. cystidiosus in 1969."</data>
      <data key="d6">chunk-33ea2f9846e58f5947feff6e3a84d189</data>
      <data key="d7">1</data>
    </edge>
