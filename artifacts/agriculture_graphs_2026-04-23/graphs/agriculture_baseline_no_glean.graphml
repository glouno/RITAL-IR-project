      <data key="d4">7.0</data>
      <data key="d5">"Italian bees are recommended as the standard starting point for those beginning the practice of beekeeping."</data>
      <data key="d6">chunk-1b5f53667458d570c2b31bf11f9a153b</data>
      <data key="d7">1</data>
    </edge>
