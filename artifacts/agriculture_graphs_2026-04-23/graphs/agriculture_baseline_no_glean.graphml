      <data key="d6">chunk-2b4618459cbb29170095bfe11ea386ab</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SUSTAINABILITY&quot;" target="&quot;NEW SOCIAL MOVEMENT THEORY&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"New social movement theory has become influential in the public conversation about sustainability, treating it as a 'banner' for diverse causes."</data>
      <data key="d6">chunk-11c2b2726c61ccaf67be15464365be01</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SUSTAINABILITY&quot;" target="&quot;SOCIAL JUSTICE&quot;">
      <data key="d4">14.0</data>
      <data key="d5">"The text discusses sustainability as a norm and suggests it can be weighed against goals of social justice and human welfare."&lt;SEP&gt;"The text explores the philosophical question of whether social justice is a component of sustainability."</data>
      <data key="d6">chunk-11c2b2726c61ccaf67be15464365be01&lt;SEP&gt;chunk-c1c64b52d1680cf9b8c87710eaab068d</data>
      <data key="d7">1</data>
    </edge>
