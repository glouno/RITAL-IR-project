      <data key="d4">10.0</data>
      <data key="d5">"CAFOs (Concentrated Animal Feeding Operations) are described as the primary manifestation of industrial farming."</data>
      <data key="d6">chunk-0c2431b3b4552aa63a72178a202c92bc</data>
      <data key="d7">1</data>
    </edge>
