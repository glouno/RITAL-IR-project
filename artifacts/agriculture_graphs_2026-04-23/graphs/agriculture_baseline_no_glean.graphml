      <data key="d6">chunk-ee2dbfbb5c1a5664034bad31b4143c62</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;ITALIAN BEES&quot;" target="&quot;DR. EISCHEN&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"Dr. Eischen discovered that smoke from certain plants can have a negative effect on honey bees."</data>
      <data key="d6">chunk-c677fc2f4fb5468d4e8323dee76a0c5a</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;ITALIAN BEES&quot;" target="&quot;DOWDA METHOD&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The Dowda method involves dusting bees with powdered substances to dislodge mites; the text notes Italian bees specifically enjoyed a garlic powder variation of this dusting."</data>
      <data key="d6">chunk-c677fc2f4fb5468d4e8323dee76a0c5a</data>
      <data key="d7">1</data>
    </edge>
