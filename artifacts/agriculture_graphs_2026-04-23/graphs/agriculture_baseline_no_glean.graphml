      <data key="d4">9.0</data>
      <data key="d5">"Supplemented sawdust blocks are incubated in the laboratory, positioned closest to the exit for removal."</data>
      <data key="d6">chunk-a4d8ffd59b496178c8be531ac64f1a01</data>
      <data key="d7">1</data>
    </edge>
