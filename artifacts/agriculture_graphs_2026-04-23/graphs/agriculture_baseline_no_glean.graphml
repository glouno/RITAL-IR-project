      <data key="d4">6.0</data>
      <data key="d5">"Both are described as options for novices to start a new bee colony."</data>
      <data key="d6">chunk-759e701020a9c2cf1b1fc48ccd55df97</data>
      <data key="d7">1</data>
    </edge>
