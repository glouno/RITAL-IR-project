      <data key="d4">9.0</data>
      <data key="d5">"Isopropanol is used for wiping countertops and hands and sterilizing tools within the laboratory."</data>
      <data key="d6">chunk-dbf4d7e7600e83223b3cb9fc4c7377fb</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PARAFILM&quot;" target="&quot;PETRI DISHES&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Parafilm is a brand of elastic wax film used to seal petri dishes to prevent airborne contamination during incubation."</data>
      <data key="d6">chunk-f8cec93f7012d0e23178b40247320a46</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PARAFILM&quot;" target="&quot;LAMINAR FLOW HOOD&quot;">
      <data key="d4">4.0</data>
      <data key="d5">"Both are used to maintain sterility and protect cultures from airborne contaminants."</data>
      <data key="d6">chunk-ffe4249d9b2a765fb568c54af6fb071b</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PETRI DISHES&quot;" target="&quot;BLANKS&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Blanks are uninoculated culture dishes used as controls to identify contamination vectors."</data>
      <data key="d6">chunk-0844446be98c91a11acfc07bb4139aa8</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PETRI DISHES&quot;" target="&quot;PRESSURE COOKER&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The pressure cooker is used to sterilize glass petri dishes and the agar medium they contain."</data>
      <data key="d6">chunk-4436e4d71bacd5341efaa6e45cf6f94f</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PETRI DISHES&quot;" target="&quot;LAMINAR FLOW HOOD&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Malt agar media is poured into sterile petri dishes in front of a laminar flow hood to maintain sterility."</data>
      <data key="d6">chunk-4436e4d71bacd5341efaa6e45cf6f94f</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PETRI DISHES&quot;" target="&quot;CLONING&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Cloning involves transferring excised mushroom tissue into a nutrient-filled petri dish."</data>
      <data key="d6">chunk-4436e4d71bacd5341efaa6e45cf6f94f</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;BLANKS&quot;" target="&quot;GRAIN JARS&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Blanks include uninoculated grain jars used for quality control tests."</data>
      <data key="d6">chunk-0844446be98c91a11acfc07bb4139aa8</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;BLANKS&quot;" target="&quot;SAWDUST/BRAN BAGS&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Blanks include uninoculated sawdust/bran bags used for quality control tests."</data>
      <data key="d6">chunk-0844446be98c91a11acfc07bb4139aa8</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;GROWING ROOMS&quot;" target="&quot;ELECTROSTATIC FILTERS&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Growing rooms use electrostatic filters to maintain positive pressurization."</data>
      <data key="d6">chunk-f65267590bffb12f3cd0f8ce0a5d22bc</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;GROWING ROOMS&quot;" target="&quot;FORKLIFTS&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Growing rooms are designed with wide entries to allow easy access for forklifts."</data>
      <data key="d6">chunk-f65267590bffb12f3cd0f8ce0a5d22bc</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;GROWING ROOMS&quot;" target="&quot;AIR SUPPLY SYSTEM&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The air supply system is specifically used to provide conditioned air to the growing rooms."</data>
      <data key="d6">chunk-f65267590bffb12f3cd0f8ce0a5d22bc</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;GROWING ROOMS&quot;" target="&quot;SPAWNING ROOM&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The spawning room is situated adjacent to the main corridor leading to the growing rooms to facilitate substrate handling."</data>
      <data key="d6">chunk-f65267590bffb12f3cd0f8ce0a5d22bc</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;GROWING ROOMS&quot;" target="&quot;MUSHROOM FARMING&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"Growing rooms are a primary environment in mushroom farming used to grow mushrooms."</data>
      <data key="d6">chunk-f65267590bffb12f3cd0f8ce0a5d22bc</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;GROWING ROOMS&quot;" target="&quot;LABORATORY&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Growing rooms are potential sources of contamination for the laboratory; the text recommends separate buildings to minimize this risk."</data>
      <data key="d6">chunk-03a51001a824f450f3fd025943f870fb</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;GROWING ROOMS&quot;" target="&quot;MUSHROOM FARMS&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Mushroom farms consist of both laboratories and growing rooms, with specific flow patterns required between them."</data>
      <data key="d6">chunk-03a51001a824f450f3fd025943f870fb</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;GROWING ROOMS&quot;" target="&quot;MODIFIED GOTHIC-FRAMED BUILDINGS&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Modified gothic-framed buildings are used as structures for growing rooms to prevent condensation dripping onto crops."</data>
      <data key="d6">chunk-0815870c654054b03e48888fd02263bf</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;GROWING ROOMS&quot;" target="&quot;PASS-THROUGH CURTAINS&quot;">
      <data key="d4">5.0</data>
      <data key="d5">"Pass-through curtains are used in some farms but are noted as not providing a tight enough seal to protect growing rooms from other environments."</data>
      <data key="d6">chunk-0815870c654054b03e48888fd02263bf</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;GROWING ROOMS&quot;" target="&quot;ENVIRONMENTAL CONTROL SYSTEMS&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Environmental control systems function more effectively when growing rooms are insulated."</data>
      <data key="d6">chunk-0815870c654054b03e48888fd02263bf</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;GROWING ROOMS&quot;" target="&quot;USDA&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"The floors of growing rooms should be painted with USDA-approved, dairy-grade cement."</data>
      <data key="d6">chunk-0815870c654054b03e48888fd02263bf</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;GROWING ROOMS&quot;" target="&quot;TEXAS REISHI PRODUCTION FACILITY&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The Texas Reishi production facility uses specific structures (modified hoop-framed greenhouses) to construct growing rooms at low cost."</data>
      <data key="d6">chunk-0815870c654054b03e48888fd02263bf</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;GROWING ROOMS&quot;" target="&quot;FOOTBATH&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Footbaths are installed prior to each growing room to disinfect footwear and prevent contamination."</data>
      <data key="d6">chunk-0815870c654054b03e48888fd02263bf</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;GROWING ROOMS&quot;" target="&quot;AIR EXCHANGE SYSTEMS&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Air exchange systems (air exchange rates) are critical in growing rooms to manage oxygen/CO2 levels and prevent disease."</data>
      <data key="d6">chunk-0815870c654054b03e48888fd02263bf</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;GROWING ROOMS&quot;" target="&quot;BUTTON MUSHROOMS&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Button mushroom growers typically fill up to 1/4 of the growing room volume with substrate."</data>
      <data key="d6">chunk-0815870c654054b03e48888fd02263bf</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;STERILIZATION INDICATOR STRIPS&quot;" target="&quot;SAWDUST/BRAN BAGS&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Indicator strips are recommended to confirm sterilization in bulk substrates like sawdust bags due to varying heat penetration."</data>
      <data key="d6">chunk-0844446be98c91a11acfc07bb4139aa8</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;STERILIZATION INDICATOR STRIPS&quot;" target="&quot;MUSHROOM CULTURE&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Indicator strips are used in the mushroom culture process to ensure substrates are fully sterilized."</data>
      <data key="d6">chunk-74e08f9019a6721b44f903e073f95b43</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;MALT AGAR&quot;" target="&quot;PRESSURE COOKER&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Malt agar is cooked/sterilized using a pressure cooker, and overcooking it at 18 psi can lead to caramelization."</data>
      <data key="d6">chunk-32de504d30a1122aa14d9280ed6f3736</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PLANT TISSUE CULTURE INDUSTRY&quot;" target="&quot;SCALPEL&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The plant tissue culture industry widely uses topical disinfection for scalpels instead of flame-sterilizing."</data>
      <data key="d6">chunk-32de504d30a1122aa14d9280ed6f3736</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PLANT TISSUE CULTURE INDUSTRY&quot;" target="&quot;GELRITE&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Gelrite is widely used as a media substitute within the plant tissue culture industry."</data>
      <data key="d6">chunk-8edfcaf26fd56cb2f24c25f369abc2f4</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PLANT TISSUE CULTURE INDUSTRY&quot;" target="&quot;AGAR&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The plant tissue culture industry uses tissue-grade agar, though pollution has affected its refinement and price."</data>
      <data key="d6">chunk-8edfcaf26fd56cb2f24c25f369abc2f4</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PRESSURE COOKER&quot;" target="&quot;SCALPEL&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"Both are categorized as tools of the trade that require sterilization to prevent contamination."</data>
      <data key="d6">chunk-32de504d30a1122aa14d9280ed6f3736</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PRESSURE COOKER&quot;" target="&quot;AGAR&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The pressure cooker is used to steam sterilize media containing agar."</data>
      <data key="d6">chunk-8edfcaf26fd56cb2f24c25f369abc2f4</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PRESSURE COOKER&quot;" target="&quot;LAMINAR FLOW HOOD&quot;">
      <data key="d4">14.0</data>
      <data key="d5">"A laminar flow hood is used as a sterile environment to open a pressure cooker if it fails to form a vacuum."&lt;SEP&gt;"The pressure cooker can be opened in front of a laminar flow bench as an alternative to a clean room."</data>
      <data key="d6">chunk-806d1be9aa2abcfd64cc0c7b7e5f0970&lt;SEP&gt;chunk-8edfcaf26fd56cb2f24c25f369abc2f4</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PRESSURE COOKER&quot;" target="&quot;HEPA FILTER&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"A pressure cooker may be placed into a HEPA filtered airstream to prevent contamination during cooldown."</data>
      <data key="d6">chunk-4436e4d71bacd5341efaa6e45cf6f94f</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PRESSURE COOKER&quot;" target="&quot;STERILIZATION INDICATOR TEST STRIPS&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Sterilization indicator test strips are placed into jars inside the pressure cooker to verify that sterilization has been achieved."</data>
      <data key="d6">chunk-806d1be9aa2abcfd64cc0c7b7e5f0970</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PRESSURE COOKER&quot;" target="&quot;LABORATORY CLEAN ROOM&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The pressure cooker is opened and cooled within the laboratory clean room to prevent contamination."</data>
      <data key="d6">chunk-806d1be9aa2abcfd64cc0c7b7e5f0970</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PRESSURE COOKER&quot;" target="&quot;ERLENMEYER FLASKS&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"Erlenmeyer flasks containing media are placed within a pressure cooker to be sterilized."</data>
      <data key="d6">chunk-946c57b33dd3ef9c4a7ec48d708a3699</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PRESSURE COOKER&quot;" target="&quot;LIQUID CULTURE MEDIA&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"The liquid culture media is sterilized using a pressure cooker at 15 psi."</data>
      <data key="d6">chunk-946c57b33dd3ef9c4a7ec48d708a3699</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PRESSURE COOKER&quot;" target="&quot;EBERBACH STIRRER&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"The Eberbach stirrer is sterilized within the pressure cooker."</data>
      <data key="d6">chunk-946c57b33dd3ef9c4a7ec48d708a3699</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PRESSURE COOKER&quot;" target="&quot;DR. STOLLER&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"Dr. Stoller invented a specialized collar/lid system for bags that are subsequently sterilized in a pressure cooker."</data>
      <data key="d6">chunk-3f7c54ea888763f1d03f685097757427</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PRESSURE COOKER&quot;" target="&quot;MUSHROOM CULTURE&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Small pressure cookers are used in mushroom culture to sterilize supplemented sawdust substrates."</data>
      <data key="d6">chunk-74e08f9019a6721b44f903e073f95b43</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SCALPEL&quot;" target="&quot;CLONING&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"A flame-sterilized scalpel is used to excise the tissue from the mushroom during the cloning process."</data>
      <data key="d6">chunk-4436e4d71bacd5341efaa6e45cf6f94f</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SCALPEL&quot;" target="&quot;PETRI DISH&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The scalpel is used to cut into the petri dish culture and spear wedges of mycelium."</data>
      <data key="d6">chunk-a0b79991796d11ec1e405378fdd328b5</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;INOCULUM&quot;" target="&quot;STERILE TISSUE CULTURE&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The inoculum is the tissue being transferred during the process of sterile tissue culture."</data>
      <data key="d6">chunk-32de504d30a1122aa14d9280ed6f3736</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;STICKY MATS&quot;" target="&quot;DOUBLE-DOOR ENTRIES&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Sticky mats are placed before each doorway of the double-door entries to remove debris from feet."</data>
      <data key="d6">chunk-2670ee5d5a1b127786199d32f59fb4c9</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;STICKY MATS&quot;" target="&quot;LABORATORY&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Sticky mats are used in the laboratory to isolate cultures and prevent cross-contamination."</data>
      <data key="d6">chunk-dbf4d7e7600e83223b3cb9fc4c7377fb</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;STERILE TISSUE CULTURE&quot;" target="&quot;BIOLOGICAL SCIENCES&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"Sterile tissue culture has revolutionized the biological sciences by allowing isolation and propagation of organisms."</data>
      <data key="d6">chunk-32de504d30a1122aa14d9280ed6f3736</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;STERILE TISSUE CULTURE&quot;" target="&quot;LOUIS PASTEUR&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"Louis Pasteur pioneered the sterile technique that made tissue culture possible by recognizing heat kills microorganisms."</data>
      <data key="d6">chunk-32de504d30a1122aa14d9280ed6f3736</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;STERILE TISSUE CULTURE&quot;" target="&quot;HEPA FILTERS&quot;">
      <data key="d4">19.0</data>
      <data key="d5">"HEPA filters make sterile tissue culture practicable and advance the field more than any other invention."&lt;SEP&gt;"The invention of HEPA filters made sterile tissue culture practicable and commercially possible for various organisms."</data>
      <data key="d6">chunk-69e12830990f7ea8d716253d971a2d83&lt;SEP&gt;chunk-32de504d30a1122aa14d9280ed6f3736</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;STERILE TISSUE CULTURE&quot;" target="&quot;LABORATORY&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Sterile tissue culture is the primary laboratory work performed by the cultivator."</data>
      <data key="d6">chunk-03a51001a824f450f3fd025943f870fb</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;LOUIS PASTEUR&quot;" target="&quot;PASTEURIZATION&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"Louis Pasteur is the namesake and discoverer of the process of pasteurization."</data>
      <data key="d6">chunk-74ff6778153d7e0699d7610f9480dc1c</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;LOUIS PASTEUR&quot;" target="&quot;GERM THEORY&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"Louis Pasteur identified 'germs' and is credited with the development and promotion of the germ theory."</data>
      <data key="d6">chunk-cd0cbc2015c40d83fecadab3a3d0a918</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;LOUIS PASTEUR&quot;" target="&quot;ANTOINE BÉCHAMP&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"They were French contemporaries with opposing views on disease; folklore suggests Pasteur endorsed Béchamp on his deathbed."</data>
      <data key="d6">chunk-cd0cbc2015c40d83fecadab3a3d0a918</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HEPA FILTERS&quot;" target="&quot;ELECTROSTATIC FILTER&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The electrostatic filter is the second stage of filtration before air reaches the final HEPA filter."</data>
      <data key="d6">chunk-69e12830990f7ea8d716253d971a2d83</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HEPA FILTERS&quot;" target="&quot;COARSE PREFILTER&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"The coarse prefilter is the first stage of a filtration sequence that culminates in the HEPA filter."</data>
      <data key="d6">chunk-69e12830990f7ea8d716253d971a2d83</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HEPA FILTERS&quot;" target="&quot;SUPPLEMENTED SAWDUST CULTURE&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"HEPA filters are used to prevent airborne contamination in supplemented sawdust cultures."</data>
      <data key="d6">chunk-a99b3c5799adf4153f31a635e31e46c5</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HEPA FILTERS&quot;" target="&quot;THE LABORATORY COMPLEX&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The Laboratory Complex uses HEPA filters to maintain positive pressurization."</data>
      <data key="d6">chunk-aea472dfebfe03f6968437bd2ffedd3d</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HEPA FILTERS&quot;" target="&quot;SPAWNING ROOM&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The spawning room utilizes HEPA filters for positive pressurization."</data>
      <data key="d6">chunk-f65267590bffb12f3cd0f8ce0a5d22bc</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HEPA FILTERS&quot;" target="&quot;PASTEURIZATION CHAMBER&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The pasteurization chamber uses HEPA filters for positive pressurization."</data>
      <data key="d6">chunk-f65267590bffb12f3cd0f8ce0a5d22bc</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HEPA FILTERS&quot;" target="&quot;PASTEURIZATION TUNNELS&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"Positive pressurization for the environment containing pasteurization tunnels is achieved through HEPA filters."</data>
      <data key="d6">chunk-712d329f1d17d42190f6d0a2c21d7b42</data>
