      <data key="d0">"PERSON"</data>
      <data key="d1">"Howard Buffett is a farmer-philanthropist whose foundation provided the support, equipment, and funding necessary to establish Africa's first no-till research center."</data>
      <data key="d2">chunk-84ff78a393ff1a0888c9e615bbd889db</data>
      <data key="d3">[{"level": 0, "cluster": 1}, {"level": 1, "cluster": 58}, {"level": 2, "cluster": 547}, {"level": 3, "cluster": 1797}]</data>
