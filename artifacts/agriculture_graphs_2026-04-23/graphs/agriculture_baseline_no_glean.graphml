      <data key="d4">7.0</data>
      <data key="d5">"Twinkies are referred to as 'sanctioned' food, implying they are approved or promoted by government standards."</data>
      <data key="d6">chunk-9d628ebc9fbc7db25894f19c606113e6</data>
      <data key="d7">1</data>
    </edge>
