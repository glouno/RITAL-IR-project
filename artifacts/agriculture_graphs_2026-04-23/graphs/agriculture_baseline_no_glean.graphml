      <data key="d4">18.0</data>
      <data key="d5">"Honey supers are additional boxes used in beekeeping to store honey."&lt;SEP&gt;"Honey supers are part of the equipment required to set up a complete hive for beekeeping."</data>
      <data key="d6">&lt;SEP&gt;chunk-f3025455da6b06dabe347fe4878bb963</data>
      <data key="d7">1</data>
    </edge>
