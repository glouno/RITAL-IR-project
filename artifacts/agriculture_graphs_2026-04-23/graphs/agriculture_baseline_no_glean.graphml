      <data key="d6">chunk-d5ce19ae9aa388ea7266cc28400656a8</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;GOVERNMENT&quot;" target="&quot;DIGIORNO'S PIZZA&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The author argues against the government forbidding the processing of food or protecting people from products like DiGiorno's pizza."</data>
      <data key="d6">chunk-d5ce19ae9aa388ea7266cc28400656a8</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;GOVERNMENT&quot;" target="&quot;COCA-COLA&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The author argues that the government should not protect people from products like Coca-Cola, as consumers are responsible for their choices."</data>
      <data key="d6">chunk-d5ce19ae9aa388ea7266cc28400656a8</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;GOVERNMENT&quot;" target="&quot;SUGARCANE&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The author suggests the government should eliminate subsidies for sugarcane."</data>
      <data key="d6">chunk-d5ce19ae9aa388ea7266cc28400656a8</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;GOVERNMENT&quot;" target="&quot;RBGH MILK&quot;">
