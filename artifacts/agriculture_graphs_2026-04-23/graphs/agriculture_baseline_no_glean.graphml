      <data key="d5">"Chalkbrood shares similar treatment recovery methods with European Foulbrood, such as requeening or infusions of young bees."</data>
      <data key="d6">chunk-ad055bc816d7df3212732523b38332d8</data>
      <data key="d7">1</data>
    </edge>
