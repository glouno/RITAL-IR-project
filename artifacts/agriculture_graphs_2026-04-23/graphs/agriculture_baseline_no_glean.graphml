      <data key="d4">10.0</data>
      <data key="d5">"The cultivator orchestrates the development of cultures and is the key to the laboratory's success or failure."</data>
      <data key="d6">chunk-dbf4d7e7600e83223b3cb9fc4c7377fb</data>
      <data key="d7">1</data>
    </edge>
