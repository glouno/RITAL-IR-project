      <data key="d6">chunk-2b4618459cbb29170095bfe11ea386ab</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SUSTAINABILITY&quot;" target="&quot;BATIE&quot;">
      <data key="d4">8.0</data>
