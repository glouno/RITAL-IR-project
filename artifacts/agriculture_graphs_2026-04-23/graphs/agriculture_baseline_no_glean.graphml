      <data key="d4">23.0</data>
      <data key="d5">"Captain Moubray is located in Southern Rhodesia and reported yields of san hemp seed."&lt;SEP&gt;"Captain Moubray is providing information from Southern Rhodesia."&lt;SEP&gt;"Captain Moubray provides information regarding agricultural results in Southern Rhodesia."</data>
      <data key="d6">chunk-255b7d3dd4c65b1204aa05695d9b10fb&lt;SEP&gt;chunk-c9be35452a55159cea361655ca53487b&lt;SEP&gt;chunk-3c9591c5b4bbe7f3fce9fbed5a80fcb5</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;CAPTAIN MOUBRAY&quot;" target="&quot;SOUTH AFRICAN FARMER'S WEEKLY&quot;">
      <data key="d4">17.0</data>
