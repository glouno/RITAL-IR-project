      <data key="d4">7.0</data>
      <data key="d5">"Norton's views are aligned with the arguments presented in the author's work 'The Spirit of the Soil' regarding system conceptualization."</data>
      <data key="d6">chunk-416c88a4653bbd08275b4ad4b3f6d0d9</data>
      <data key="d7">1</data>
    </edge>
