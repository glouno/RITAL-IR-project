      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Colleges and universities are academic institutions that offer coursework and degrees in the science of beekeeping."</data>
      <data key="d2">chunk-1b5f53667458d570c2b31bf11f9a153b</data>
      <data key="d3">[{"level": 0, "cluster": 31}, {"level": 1, "cluster": 406}, {"level": 2, "cluster": 1543}, {"level": 3, "cluster": 2034}]</data>
