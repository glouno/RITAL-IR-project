      <data key="d4">9.0</data>
      <data key="d5">"The NPK mentality is the attitude of mind that sees all virtue in the use of artificials (nitrogen, potassium, and phosphorus)."</data>
      <data key="d6">chunk-f54ae758c012dc186d43caf6a059360a</data>
      <data key="d7">1</data>
    </edge>
