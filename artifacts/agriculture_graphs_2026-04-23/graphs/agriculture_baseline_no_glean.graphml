      <data key="d6">chunk-3c3e0c4c99d600e81552689af79afdcd</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;VEIL&quot;" target="&quot;HIVE&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The veil is protective gear donned by the beekeeper before proceeding to the hive for inspection."</data>
      <data key="d6">chunk-4ff7d8f22cb1bb72cdb48f20d4975e8d</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;VEIL&quot;" target="&quot;FEEDER&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"The veil is protective gear worn by the beekeeper while checking or refilling the feeder."</data>
      <data key="d6">chunk-50100ec9bbd638fb693fc24eeb2b3110</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;VEIL&quot;" target="&quot;BEEKEEPER&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The beekeeper wears a veil for protection and must be careful not to melt its screening with the smoker's flame."</data>
      <data key="d6">chunk-dee772a46eb60a47d303c4f69578a182</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;VEIL&quot;" target="&quot;EUROPEAN HONEY BEE&quot;">
