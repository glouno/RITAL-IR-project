      <data key="d6">chunk-f11bd11cdae96ea0e8cfc407a935884e</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TESSIER&quot;" target="&quot;METHODICAL ENCYCLOPCEDIA OF AGRICULTURE&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"Tessier is one of the three French agronomists who wrote the Methodical Encyclopcedia of Agriculture."</data>
      <data key="d6">chunk-81b8b8502370c6624f8c498266b33fb3</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THOUIN&quot;" target="&quot;JARDIN DES PLANTES&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"Thouin served as the chief gardener at the Jardin des Plantes."</data>
      <data key="d6">chunk-f11bd11cdae96ea0e8cfc407a935884e</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THOUIN&quot;" target="&quot;ACADÉMIE DES SCIENCES&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Thouin became a member of the Académie des Sciences in 1795."</data>
      <data key="d6">chunk-f11bd11cdae96ea0e8cfc407a935884e</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THOUIN&quot;" target="&quot;BOSC&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Thouin and Bosc were colleagues and co-authors of the Methodical Encyclopcedia of Agriculture."</data>
      <data key="d6">chunk-f11bd11cdae96ea0e8cfc407a935884e</data>
      <data key="d7">1</data>
    </edge>
