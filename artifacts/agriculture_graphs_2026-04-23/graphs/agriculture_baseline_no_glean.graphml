    </edge>
    <edge source="&quot;CAPTAIN MOUBRAY&quot;" target="&quot;SIR ALBERT HOWARD&quot;">
      <data key="d4">25.0</data>
      <data key="d5">"Captain Moubray provided results and contributed appendices to Sir Albert Howard's work regarding organic farming in South Africa and Rhodesia."&lt;SEP&gt;"Captain Moubray references Sir Albert Howard's Indore Process of composting as a cure for soil ills."&lt;SEP&gt;"Captain Moubray refers to advice given to him by Sir Albert Howard regarding the use of compost as an inoculant."</data>
      <data key="d6">chunk-f01a9018938914804f49a80182b2f205&lt;SEP&gt;chunk-c9be35452a55159cea361655ca53487b&lt;SEP&gt;chunk-f7e8b4bde4465470684d8ec0af5b158a</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;CAPTAIN MOUBRAY&quot;" target="&quot;MAZOE VALLEY&quot;">
      <data key="d4">18.0</data>
      <data key="d5">"Captain Moubray conducted subsoiling operations within the Mazoe valley."&lt;SEP&gt;"Captain Moubray writes about orange groves located in the Mazoe valley."</data>
      <data key="d6">chunk-993680272f3e5678f61ebce7fc3d0706&lt;SEP&gt;chunk-3c9591c5b4bbe7f3fce9fbed5a80fcb5</data>
