    </edge>
    <edge source="&quot;AN AGRICULTURAL TESTAMENT&quot;" target="&quot;PECKHAM HEALTH CENTRE&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The book 'An Agricultural Testament' describes the work accomplished at the Peckham Health Centre."</data>
      <data key="d6">chunk-6930a29b100d665f24c78c209eccf850</data>
      <data key="d7">1</data>
    </edge>
