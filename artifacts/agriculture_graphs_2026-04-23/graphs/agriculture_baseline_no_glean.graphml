      <data key="d4">8.0</data>
      <data key="d5">"The NOSB is tasked with advising the US Secretary of Agriculture on program implementation policies."</data>
      <data key="d6">chunk-b464827b98fd832772a9e2806f166940</data>
      <data key="d7">1</data>
    </edge>
