      <data key="d6">chunk-a9465e78f869f57a714827f88ed9c132</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;VEIL&quot;" target="&quot;COVERALLS&quot;">
      <data key="d4">8.0</data>
