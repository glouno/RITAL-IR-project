      <data key="d4">6.0</data>
      <data key="d5">"Hegel's framework suggests consciousness recognizes its social being through embodiment in institutions like the state."</data>
      <data key="d6">chunk-fa6c175f37ce7089fa657f33595c666c</data>
      <data key="d7">1</data>
    </edge>
