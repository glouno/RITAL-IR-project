      <data key="d4">10.0</data>
      <data key="d5">"Rush Wayne refined the Hydrogen Peroxide Technique to a practical level and published a booklet on it."</data>
      <data key="d6">chunk-55b455785e50a372ec04e37703a73ab7</data>
      <data key="d7">1</data>
    </edge>
