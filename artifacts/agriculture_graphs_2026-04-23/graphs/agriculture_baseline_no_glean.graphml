    <node id="&quot;HOLLING&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Holling is a scholar associated with sustainability grounded in ecosystem resilience, stability, and the concept of panarchy."</data>
      <data key="d2">chunk-ddd79b341dfcb637bbc86f0265484513</data>
    </node>
    <node id="&quot;HOLLING SUSTAINABILITY&quot;">
