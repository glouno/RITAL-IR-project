      <data key="d4">6.0</data>
      <data key="d5">"Beekeeping can expand from a hobby into crop pollination if the beekeeper acquires enough hives."</data>
      <data key="d6">chunk-f3025455da6b06dabe347fe4878bb963</data>
      <data key="d7">1</data>
    </edge>
