      <data key="d4">8.0</data>
      <data key="d5">"The results obtained at Marden Park were detailed in Chapter VII of 'An Agricultural Testament'."</data>
      <data key="d6">chunk-9679e4b4c295f8198842b6678d29d7bb</data>
      <data key="d7">1</data>
    </edge>
