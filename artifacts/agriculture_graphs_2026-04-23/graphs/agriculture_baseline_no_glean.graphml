      <data key="d4">7.0</data>
      <data key="d5">"The activities and methods of the Shahjahanpur Experiment Station are described in 'An Agricultural Testament'."</data>
      <data key="d6">chunk-c77007ae0e7683a83dbebd6436fa3c92</data>
      <data key="d7">1</data>
    </edge>
