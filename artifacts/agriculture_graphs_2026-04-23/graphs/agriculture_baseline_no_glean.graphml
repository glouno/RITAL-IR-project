    </edge>
    <edge source="&quot;DENNIS&quot;" target="&quot;CONVENTIONAL PRACTICES&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Dennis consciously walked away from conventional practices to improve his farm's productivity and environmental health."</data>
      <data key="d6">chunk-53f69fd7bda60518d54e55e7ff039d4c</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;DENNIS&quot;" target="&quot;PIONEER TRAIL&quot;">
      <data key="d4">4.0</data>
