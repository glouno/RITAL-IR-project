      <data key="d4">8.0</data>
      <data key="d5">"VSH genes are present in certain strains of European honey bees, enabling them to remove mite-infested larvae."</data>
      <data key="d6">chunk-28ac9aabed87efda91436e0c9b5ff311</data>
      <data key="d7">1</data>
    </edge>
