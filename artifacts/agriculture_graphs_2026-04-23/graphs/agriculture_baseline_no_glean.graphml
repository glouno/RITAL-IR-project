      <data key="d6">chunk-1b5f53667458d570c2b31bf11f9a153b</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;COLLEGES AND UNIVERSITIES&quot;" target="&quot;BEEKEEPING&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Colleges and universities offered coursework and degrees in the science of beekeeping."</data>
      <data key="d6">chunk-1b5f53667458d570c2b31bf11f9a153b</data>
      <data key="d7">1</data>
    </edge>
