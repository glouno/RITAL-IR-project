      <data key="d4">8.0</data>
      <data key="d5">"The landed gentry directed the enclosure movement to suit the interests of their estates, contributing significantly to farming."</data>
      <data key="d6">chunk-0abe6d6aad96f7bd4478403f4370b98d</data>
      <data key="d7">1</data>
    </edge>
