    <edge source="&quot;GEORGE CLARKE&quot;" target="&quot;SHAHJAHANPUR&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"George Clarke obtained results on green-manuring and trench cultivation at Shahjahanpur."</data>
      <data key="d6">chunk-5e1e151c82b3fc06c79b833667c8828b</data>
