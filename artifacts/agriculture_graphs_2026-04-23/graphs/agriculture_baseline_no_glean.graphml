      <data key="d6">chunk-d5ce19ae9aa388ea7266cc28400656a8</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;GOVERNMENT&quot;" target="&quot;TODAY SHOW&quot;">
      <data key="d4">6.0</data>
