      <data key="d6">chunk-806d1be9aa2abcfd64cc0c7b7e5f0970</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;ISOPROPANOL&quot;" target="&quot;ANTIBACTERIAL SOAP&quot;">
