      <data key="d4">8.0</data>
      <data key="d5">"The author uses the book 'The Spirit of the Soil' to argue that sustainability should be understood through concepts like functional integrity."</data>
      <data key="d6">chunk-b96ca94eb3fc51223443470c6a960c19</data>
      <data key="d7">1</data>
    </edge>
