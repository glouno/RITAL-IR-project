      <data key="d4">9.0</data>
      <data key="d5">"Howard, Louise E. authored a work published by the Royal Institute of International Affairs."</data>
      <data key="d6">chunk-75cc73a73aa1db4b46b480931b5836ef</data>
      <data key="d7">1</data>
    </edge>
