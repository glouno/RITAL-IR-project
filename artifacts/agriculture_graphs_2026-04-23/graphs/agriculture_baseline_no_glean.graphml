      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Federal research facilities are government-run organizations that develop scientific knowledge and research related to beekeeping and agriculture."</data>
      <data key="d2">chunk-1b5f53667458d570c2b31bf11f9a153b</data>
