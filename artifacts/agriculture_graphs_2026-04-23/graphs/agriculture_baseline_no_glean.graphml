      <data key="d6">chunk-e187da58191464d057a3f1d2d09c423c</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;AN AGRICULTURAL TESTAMENT&quot;" target="&quot;SIR ALBERT HOWARD&quot;">
      <data key="d4">20.0</data>
      <data key="d5">"Sir Albert Howard wrote and published the book An Agricultural Testament in 1940."&lt;SEP&gt;"Sir Albert Howard wrote the foundational book titled 'An Agricultural Testament'."</data>
      <data key="d6">chunk-dc30b96f19db572c69aecf37c0f0b030&lt;SEP&gt;chunk-1932cb031e5713bde84668b6254f5c5d</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;AN AGRICULTURAL TESTAMENT&quot;" target="&quot;INDIA&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The book was a product of Howard's years of work as a government scientist in India."</data>
      <data key="d6">chunk-1932cb031e5713bde84668b6254f5c5d</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;AN AGRICULTURAL TESTAMENT&quot;" target="&quot;MYCORRHIZAL ASSOCIATION&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The book advocates for the maintenance of an adequate reserve system of feeding the plant, specifically not interrupting the mycorrhizal association."</data>
      <data key="d6">chunk-7c29c0579cd80e1a7dbd0b335ca85272</data>
      <data key="d7">1</data>
    </edge>
