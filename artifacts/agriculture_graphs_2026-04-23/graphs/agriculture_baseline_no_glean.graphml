      <data key="d6">chunk-eab95e1bb81bb8b8be8218de8fe0f4db</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SPORES&quot;" target="&quot;INCOMPATIBILITY FACTORS (A AND B)&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"The mating of spores is genetically determined and governed by incompatibility factors A and B, which dictate which spores can combine."</data>
