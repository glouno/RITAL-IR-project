      <data key="d4">9.0</data>
      <data key="d5">"Local beekeepers' organizations often hold annual bee schools for beginners."</data>
      <data key="d6">chunk-759e701020a9c2cf1b1fc48ccd55df97</data>
      <data key="d7">1</data>
    </edge>
