      <data key="d6">chunk-5181a113eeffb24e1b85b75fd426e595</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;AN AGRICULTURAL TESTAMENT&quot;" target="&quot;PUSA&quot;">
      <data key="d4">18.0</data>
      <data key="d5">"Further details of investigations made at Pusa on the guava are found in the book 'An Agricultural Testament'."&lt;SEP&gt;"The results of ten years of work conducted at Pusa are summarized in Chapter IX of An Agricultural Testament."</data>
      <data key="d6">chunk-2be6b9145cdce9275f8166f477a4339b&lt;SEP&gt;chunk-93fd8b3490e045fee1663a444486deee</data>
      <data key="d7">1</data>
    </edge>
