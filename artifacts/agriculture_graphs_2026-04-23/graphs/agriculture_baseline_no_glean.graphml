      <data key="d4">7.0</data>
      <data key="d5">"John Dewey acknowledges that modern physics provides a coherent theoretical understanding based on Cartesian projections."</data>
      <data key="d6">chunk-3a9d0dea50021742bc52cffc66eae1b4</data>
      <data key="d7">1</data>
    </edge>
