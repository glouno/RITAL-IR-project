      <data key="d4">10.0</data>
      <data key="d5">"Priestley discovered oxygen, which opened new vistas in the study of plant assimilation."</data>
      <data key="d6">chunk-75cc73a73aa1db4b46b480931b5836ef</data>
      <data key="d7">1</data>
    </edge>
