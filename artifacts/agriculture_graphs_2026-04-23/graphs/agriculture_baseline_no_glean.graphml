      <data key="d4">8.0</data>
      <data key="d5">"The retort is a piece of equipment located within the laboratory building used for sterilization."</data>
      <data key="d6">chunk-03a51001a824f450f3fd025943f870fb</data>
      <data key="d7">1</data>
    </edge>
