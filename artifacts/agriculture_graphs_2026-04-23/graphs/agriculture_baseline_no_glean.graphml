      <data key="d4">6.0</data>
      <data key="d5">"The Doukhobors believed it was a sin to wound the earth (Nature) with tools."</data>
      <data key="d6">chunk-cbe735eff1ddb5f51823657c9cb6e03f</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;NATURE&quot;" target="&quot;SHIFTING CULTIVATION&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Shifting cultivation relies on Nature to overrun cultivated patches with scrub or forest to restore soil fertility."</data>
      <data key="d6">chunk-cbe735eff1ddb5f51823657c9cb6e03f</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;NATURE&quot;" target="&quot;PROFIT MOTIVE&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The profit motive is described as the crystallized result of societies utilizing natural surpluses provided by Nature."</data>
      <data key="d6">chunk-571b3fa101d4bb8e213e6691eda956ff</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;NATURE&quot;" target="&quot;AGRICULTURE&quot;">
      <data key="d4">18.0</data>
      <data key="d5">"Agriculture is described as an interference with, interruption of, or interception of natural processes and Nature's rules."&lt;SEP&gt;"Agriculture relies on the elasticity and supplies of Nature, but the text warns that pursuing quantity beyond natural laws leads to exploitation."</data>
      <data key="d6">chunk-571b3fa101d4bb8e213e6691eda956ff&lt;SEP&gt;chunk-550966fca0f2f090187553fe9bc99e80</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;NATURE&quot;" target="&quot;EUROPEAN FARMING&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"European farming is described as 'robbery on a vast scale' due to the importation of guanos and manures, exploiting stored-up natural wealth from other regions."</data>
      <data key="d6">chunk-571b3fa101d4bb8e213e6691eda956ff</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;NATURE&quot;" target="&quot;YOUNIS SABET&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Younis Sabet recorded the mycorrhizal relationship in Egypt in the journal Nature."</data>
      <data key="d6">chunk-9ff493a2aa6061d02c444386e37f3a6e</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;NATURE&quot;" target="&quot;GREAT BRITAIN&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"The text refers to the restoration of soil fertility in Great Britain, which is governed by natural processes and laws."</data>
      <data key="d6">chunk-7ad44bd47e01a1d6bfb342156af1965f</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;NATURE&quot;" target="&quot;WESTERN AGRICULTURE&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Western agriculture is identified as having short-term omissions that interfere with the natural fertility cycle."</data>
      <data key="d6">chunk-7ad44bd47e01a1d6bfb342156af1965f</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;NATURE&quot;" target="&quot;PLANTATION AGRICULTURE&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Plantation agriculture is identified as having short-term omissions that interfere with the natural fertility cycle."</data>
      <data key="d6">chunk-7ad44bd47e01a1d6bfb342156af1965f</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;NATURE&quot;" target="&quot;PHOSPHATES&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Phosphates are essential minerals that Nature restores to the soil via forest roots and are sourced from primary rocks."</data>
      <data key="d6">chunk-7ad44bd47e01a1d6bfb342156af1965f</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;NATURE&quot;" target="&quot;AGRICULTURAL REVOLUTION&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The farmers leading the new agricultural revolution view farming as working with, rather than against, nature."</data>
      <data key="d6">chunk-a50a07328bb0a1a78dc4b1422311f893</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;NATURE&quot;" target="&quot;EUROPEAN HEAT WAVE OF 2003&quot;">
      <data key="d4">4.0</data>
      <data key="d5">"The journal Nature published a paper regarding climate change limits, while the European heat wave of 2003 is cited as a real-world example of the crop yield reductions caused by such temperature rises."</data>
      <data key="d6">chunk-5753cf47228cedb4b58dfbff8318e398</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;NATURE&quot;" target="&quot;LAL&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Lal was riled by a 2014 paper published in the journal Nature, as he disagreed with its conclusions regarding no-till farming yields."</data>
      <data key="d6">chunk-c69d184d39c4fc61b176c219e8852dce</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;NATURE&quot;" target="&quot;D. TILMAN&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"D. Tilman authored a paper published in Nature."</data>
      <data key="d6">chunk-bcd140f4d99d1b2503c614d0206518dd</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;NATURE&quot;" target="&quot;DRINKWATER, L. E.&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"DRINKWATER, L. E. is an author of a research paper published in the journal Nature."</data>
      <data key="d6">chunk-f583a53a338f37e2fd8d21aeb1478f22</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;NATURE&quot;" target="&quot;P. WAGONER&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"P. WAGONER is an author of a research paper published in the journal Nature."</data>
      <data key="d6">chunk-f583a53a338f37e2fd8d21aeb1478f22</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;NATURE&quot;" target="&quot;M. SARRANTONIO&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"M. SARRANTONIO is an author of a research paper published in the journal Nature."</data>
      <data key="d6">chunk-f583a53a338f37e2fd8d21aeb1478f22</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;MICROSCOPE&quot;" target="&quot;ALGAE&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The microscope is used to disclose the existence and variety of algae in stagnant water."</data>
      <data key="d6">chunk-aff6fbf3f5ff09df476cd44ec19e3d67</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;MICROSCOPE&quot;" target="&quot;FUNGI&quot;">
      <data key="d4">18.0</data>
      <data key="d5">"A microscope (or lens) is used to observe the soil fungi functioning within the interstices of the soil."&lt;SEP&gt;"The microscope allows the magnification of mouldy bread to reveal fungi."</data>
      <data key="d6">chunk-aff6fbf3f5ff09df476cd44ec19e3d67&lt;SEP&gt;chunk-456bc896ed30713380e8b9384c79721c</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;MICROSCOPE&quot;" target="&quot;PASTEUR&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Pasteur's investigations into microbial populations were made possible because they were discoverable to the microscope."</data>
      <data key="d6">chunk-f54ae758c012dc186d43caf6a059360a</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;ALGAE&quot;" target="&quot;LICHENS&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Algae and lichens are lower forms of plant life that can live on exposed surfaces and build up stores of humus."</data>
      <data key="d6">chunk-99784ea26eb49f531558abb48e57b6a5</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;ALGAE&quot;" target="&quot;PV&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"PV and Algae are both listed as examples of small-scale energy production tinkering."</data>
      <data key="d6">chunk-15a140060d3e3d6e8b8621035f57c83f</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;ALGAE&quot;" target="&quot;WOODGAS&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"Woodgas and Algae are both listed as examples of small-scale energy production tinkering."</data>
      <data key="d6">chunk-15a140060d3e3d6e8b8621035f57c83f</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;FUNGI&quot;" target="&quot;SOIL POPULATION&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"Fungi are one of the living organisms that make up the soil population."</data>
      <data key="d6">chunk-456bc896ed30713380e8b9384c79721c</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;FUNGI&quot;" target="&quot;INSECTS&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"Fungi decompose organic matter which is then further processed as it passes through the bodies of insects."</data>
      <data key="d6">chunk-99784ea26eb49f531558abb48e57b6a5</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SUNLIGHT&quot;" target="&quot;CHLOROPHYLL&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"Sunlight is the source of energy which chlorophyll, located in the green leaf, intercepts to enable plant growth."</data>
      <data key="d6">chunk-3cbbf08936e127d696a15794ccea1707</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;CHLOROPHYLL&quot;" target="&quot;CARBON-DIOXIDE&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Chlorophyll acts as the power unit that allows the plant to absorb carbon-dioxide from the air to manufacture food."</data>
      <data key="d6">chunk-3cbbf08936e127d696a15794ccea1707</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;CHLOROPHYLL&quot;" target="&quot;SOIL SOLUTION&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"Chlorophyll in the leaf manufactures food using raw materials, such as chemical salts, that are absorbed from the soil solution by the roots."</data>
      <data key="d6">chunk-456bc896ed30713380e8b9384c79721c</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;CARBON-DIOXIDE&quot;" target="&quot;CARBOHYDRATES&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Carbon-dioxide is a raw material assimilated by the plant to create organic compounds, including carbohydrates."</data>
      <data key="d6">chunk-3cbbf08936e127d696a15794ccea1707</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;CARBON-DIOXIDE&quot;" target="&quot;PROTEINS&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Carbon-dioxide is a raw material assimilated by the plant to create organic compounds, including proteins."</data>
      <data key="d6">chunk-3cbbf08936e127d696a15794ccea1707</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PROTEINS&quot;" target="&quot;VASCULAR BUNDLES&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Proteins carry out their work within a cellulose framework supported by the vascular bundles."</data>
      <data key="d6">chunk-3cbbf08936e127d696a15794ccea1707</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;EAST MALLING&quot;" target="&quot;LANE'S PRINCE ALBERT&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"East Malling is the location of the observation chamber where the root-tip of Lane's Prince Albert is being studied."</data>
      <data key="d6">chunk-3cbbf08936e127d696a15794ccea1707</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;LANE'S PRINCE ALBERT&quot;" target="&quot;M XV7&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"Lane's Prince Albert is a variety of apple grafted on the M XV7 root-stock."</data>
      <data key="d6">chunk-3cbbf08936e127d696a15794ccea1707</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;LANE'S PRINCE ALBERT&quot;" target="&quot;SOIL FUNGI&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Fungous strands of soil fungi were observed in direct contact with the growing root of a Lane's Prince Albert apple tree."</data>
      <data key="d6">chunk-d0745126232bd711152a0184bdc10060</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SOIL SOLUTION&quot;" target="&quot;CHEMICAL SALTS&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The soil solution contains dissolved substances known as chemical salts, such as nitrates and compounds of potassium and phosphorus."</data>
      <data key="d6">chunk-456bc896ed30713380e8b9384c79721c</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SOIL POPULATION&quot;" target="&quot;PROTOZOA&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"Protozoa are identified as being part of the living soil population."</data>
      <data key="d6">chunk-456bc896ed30713380e8b9384c79721c</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SOIL POPULATION&quot;" target="&quot;MOTHER EARTH&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The poetic concept of 'Mother Earth' as the source of being is scientifically examined through the study of the soil population."</data>
      <data key="d6">chunk-456bc896ed30713380e8b9384c79721c</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;MOTHER EARTH&quot;" target="&quot;MYCOLOGISTS&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"The text questions how the work of mycologists (fungi experts) is performed by Mother Earth in the natural world."</data>
      <data key="d6">chunk-2b6f8bdb7d910bab994c57a8e47dd2c1</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;MOTHER EARTH&quot;" target="&quot;ENTOMOLOGISTS&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"The text questions how the work of entomologists (insect experts) is performed by Mother Earth in the natural world."</data>
      <data key="d6">chunk-2b6f8bdb7d910bab994c57a8e47dd2c1</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;MOTHER EARTH&quot;" target="&quot;VETERINARIANS&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"The text questions how the work of veterinarians is performed by Mother Earth in the natural world."</data>
      <data key="d6">chunk-2b6f8bdb7d910bab994c57a8e47dd2c1</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;MOTHER EARTH&quot;" target="&quot;SOLAR AGE&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"The Solar Age is presented as a future era based on the full utilization of the earth's green carpet and a new relationship with nature."</data>
      <data key="d6">chunk-49e54f756180fea1648a4f8a1c56a989</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;MOTHER EARTH&quot;" target="&quot;GREAT BRITAIN&quot;">
      <data key="d4">5.0</data>
      <data key="d5">"The text suggests that in Great Britain, people are making blunders that will lead to an adverse verdict from Mother Earth."</data>
      <data key="d6">chunk-49e54f756180fea1648a4f8a1c56a989</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SOIL FUNGI&quot;" target="&quot;DR. ROGERS&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Dr. Rogers conducted experiments observing soil fungi at work in the root systems of fruit trees."</data>
      <data key="d6">chunk-d0745126232bd711152a0184bdc10060</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SOIL FUNGI&quot;" target="&quot;MYCELIUM&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"The fungous threads of soil fungi are scientifically referred to as mycelium."</data>
      <data key="d6">chunk-d0745126232bd711152a0184bdc10060</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;DR. ROGERS&quot;" target="&quot;EAST MAILING RESEARCH STATION&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Dr. Rogers performed his experiments on root systems at the East Mailing Research Station."</data>
      <data key="d6">chunk-d0745126232bd711152a0184bdc10060</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;MYCELIUM&quot;" target="&quot;HYPHA&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Hyphae reproduce mitotically and, when two compatible spores fuse, they form the resulting mycelium."</data>
      <data key="d6">chunk-eab95e1bb81bb8b8be8218de8fe0f4db</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;MYCELIUM&quot;" target="&quot;SPORES&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Compatible spores come together and mate to create a more vigorous form of mycelium."</data>
      <data key="d6">chunk-eab95e1bb81bb8b8be8218de8fe0f4db</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;MYCELIUM&quot;" target="&quot;SCALPEL&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The scalpel is used to cut and move wedges of mycelium from the agar to the jars."</data>
      <data key="d6">chunk-a0b79991796d11ec1e405378fdd328b5</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;MYCELIUM&quot;" target="&quot;AGAR&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"Mycelium grows on the nutrified agar medium within the petri dish."</data>
      <data key="d6">chunk-a0b79991796d11ec1e405378fdd328b5</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;MYCELIUM&quot;" target="&quot;G2 GALLON JARS&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Mycelium is transferred from petri dishes or grain masters into G2 gallon jars of sterilized grain."</data>
      <data key="d6">chunk-a0b79991796d11ec1e405378fdd328b5</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;MYCELIUM&quot;" target="&quot;THE AUTHOR&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"The author describes the process of colonizing grain jars with mycelium and shares a personal injury sustained during this process."</data>
      <data key="d6">chunk-80e0dc21ada528d33f0ae4834222026f</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;MYCELIUM&quot;" target="&quot;OYSTER&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Oyster mushrooms produce mycelium that has a grayish white appearance before flushing with bright white."</data>
      <data key="d6">chunk-80e0dc21ada528d33f0ae4834222026f</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;MYCELIUM&quot;" target="&quot;SHIITAKE&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Shiitake mushrooms produce mycelium that has a grayish white appearance before flushing with bright white."</data>
      <data key="d6">chunk-80e0dc21ada528d33f0ae4834222026f</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;MYCELIUM&quot;" target="&quot;ENOKITAKE&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Enokitake mushrooms produce mycelium that has a grayish white appearance before flushing with bright white."</data>
      <data key="d6">chunk-80e0dc21ada528d33f0ae4834222026f</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;MYCELIUM&quot;" target="&quot;REISHI&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Reishi mushrooms produce mycelium that has a grayish white appearance before flushing with bright white."</data>
      <data key="d6">chunk-80e0dc21ada528d33f0ae4834222026f</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;MYCELIUM&quot;" target="&quot;KING STROPHARIA&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"King Stropharia mushrooms produce mycelium that has a grayish white appearance before flushing with bright white."</data>
      <data key="d6">chunk-80e0dc21ada528d33f0ae4834222026f</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;MYCELIUM&quot;" target="&quot;SPAWN LABORATORIES&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Spawn laboratories manage the expansion and generation of mycelium-colonized grain spawn."</data>
      <data key="d6">chunk-80e0dc21ada528d33f0ae4834222026f</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;MYCELIUM&quot;" target="&quot;LIQUID CULTURE&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Liquid culture is presented as an alternative method for generating the mycelium spawn."</data>
      <data key="d6">chunk-80e0dc21ada528d33f0ae4834222026f</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;MYCELIUM&quot;" target="&quot;GRAIN SPAWN&quot;">
      <data key="d4">26.0</data>
      <data key="d5">"After inoculation, the grain kernels in the bags become surrounded by fuzzy mycelium."&lt;SEP&gt;"Grain spawn is used to inoculate other substrates, and its purity depends on the health of the mycelium."&lt;SEP&gt;"Mycelium is inoculated into grain jars to create grain spawn, and the amount of mycelium affects the inoculation rate."</data>
      <data key="d6">chunk-2c8c8ff82911884af1d7f6dd1d5a5310&lt;SEP&gt;chunk-a99b3c5799adf4153f31a635e31e46c5</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;MYCELIUM&quot;" target="&quot;SAWDUST SPAWN BAGS&quot;">
