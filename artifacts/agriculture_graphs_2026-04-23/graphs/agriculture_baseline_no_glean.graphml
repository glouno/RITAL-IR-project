      <data key="d4">7.0</data>
      <data key="d5">"Observations made at Quetta are described in the publication 'An Agricultural Testament'."</data>
      <data key="d6">chunk-3c9591c5b4bbe7f3fce9fbed5a80fcb5</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;AN AGRICULTURAL TESTAMENT&quot;" target="&quot;CHESHIRE PANEL DOCTORS&quot;">
      <data key="d4">8.0</data>
