      <data key="d4">5.0</data>
      <data key="d5">"Both are antibiotics/medicines used in apiaries to control diseases like foulbrood and nosema."</data>
      <data key="d6">chunk-162427b12ed8d1e50c5d8b055e2cd5f1</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TERRAMYCIN&quot;" target="&quot;APISTAN&quot;">
      <data key="d4">5.0</data>
      <data key="d5">"Both are chemicals used by beekeepers to manage hive health or pests."</data>
      <data key="d6">chunk-162427b12ed8d1e50c5d8b055e2cd5f1</data>
      <data key="d7">1</data>
    </edge>
