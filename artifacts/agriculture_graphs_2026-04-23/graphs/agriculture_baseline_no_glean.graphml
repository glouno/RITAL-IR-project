      <data key="d6">chunk-d5ce19ae9aa388ea7266cc28400656a8</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIGH-FRUCTOSE CORN SYRUP&quot;" target="&quot;AGRICULTURE&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"High-fructose corn syrup is a processed sweetener derived from agricultural corn."</data>
      <data key="d6" />
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;POLLEN SUBSTITUTE&quot;" target="&quot;POLLEN SUPPLEMENT&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Pollen substitute is combined with pure pollen to create a pollen supplement."</data>
      <data key="d6">chunk-824704426592ed72e9ae44a04bd1ddbd</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;POLLEN SUBSTITUTE&quot;" target="&quot;POLLEN PATTIES&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"Pollen patties are made by mixing pollen substitute with sugar syrup to create a dough."</data>
      <data key="d6">chunk-3646f7feb4b27315450c6eb80594e753</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;BEE COLONY&quot;" target="&quot;FORAGING&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Foraging is an efficient undertaking where the colony exploits its neighborhood for rewarding sources."</data>
      <data key="d6">chunk-6f51ec44f0c17ad5253b21395cf12591</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SCOUT BEE&quot;" target="&quot;FORAGING&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The scout bee randomly searches for new sources and determines if they are worth touting to the colony."</data>
      <data key="d6">chunk-6f51ec44f0c17ad5253b21395cf12591</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SCOUT BEE&quot;" target="&quot;THE DANCE LANGUAGE&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"The scout bee communicates the existence and location of new sources to hivemates by dancing."</data>
      <data key="d6">chunk-6f51ec44f0c17ad5253b21395cf12591</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THE DANCE LANGUAGE&quot;" target="&quot;FORAGING&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The dance language is used to inform hivemates of the availability, quantity, and quality of foraging resources."</data>
      <data key="d6">chunk-6f51ec44f0c17ad5253b21395cf12591</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THE DANCE LANGUAGE&quot;" target="&quot;ROUND DANCE&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"The round dance is one of the two primary dances used to signal new foraging locations."</data>
      <data key="d6">chunk-6f51ec44f0c17ad5253b21395cf12591</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THE DANCE LANGUAGE&quot;" target="&quot;WAG-TAIL DANCE&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"The wag-tail dance is one of the two primary dances used to signal new foraging locations."</data>
      <data key="d6">chunk-6f51ec44f0c17ad5253b21395cf12591</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THE DANCE LANGUAGE&quot;" target="&quot;THE ROUND DANCE&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The round dance is a specific type of communication within the broader dance language used by bees to signal food sources within 100 meters."</data>
      <data key="d6">chunk-3ca6767b0793c7530226a6b224d0f21b</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THE DANCE LANGUAGE&quot;" target="&quot;THE WAG-TAIL DANCE&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The wag-tail dance is a sophisticated part of the dance language used to convey precise distance and direction for sources over 100 meters."</data>
      <data key="d6">chunk-3ca6767b0793c7530226a6b224d0f21b</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THE DANCE LANGUAGE&quot;" target="&quot;THE ALARM DANCE&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The alarm dance is a component of the dance language used to warn the hive of contaminated or poisonous food."</data>
      <data key="d6">chunk-3ca6767b0793c7530226a6b224d0f21b</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THE DANCE LANGUAGE&quot;" target="&quot;THE SICKLE OR CRESCENT DANCE&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The sickle or crescent dance is recognized as a transitional form between the round and wag-tail dances within the dance language."</data>
      <data key="d6">chunk-3ca6767b0793c7530226a6b224d0f21b</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THE DANCE LANGUAGE&quot;" target="&quot;THE CLEANING DANCE&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The cleaning dance is a specific communication within the dance language used to solicit grooming from other bees."</data>
      <data key="d6">chunk-3ca6767b0793c7530226a6b224d0f21b</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THE DANCE LANGUAGE&quot;" target="&quot;RESEARCHERS&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Researchers observed and interpreted the dance language to analyze the foraging behavior of a colony."</data>
      <data key="d6">chunk-3ca6767b0793c7530226a6b224d0f21b</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THE ROUND DANCE&quot;" target="&quot;THE WAG-TAIL DANCE&quot;">
      <data key="d4">5.0</data>
      <data key="d5">"The sickle or crescent dance serves as a transition between these two primary types of foraging dances."</data>
      <data key="d6">chunk-3ca6767b0793c7530226a6b224d0f21b</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;GARDEN CART&quot;" target="&quot;WHEELBARROW&quot;">
      <data key="d4">5.0</data>
      <data key="d5">"Both are suggested as tools to bring close to the hive for moving parts during disassembly."</data>
      <data key="d6">chunk-0a230cf3f43e673f8797237bc5d97548</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;WHEELBARROW&quot;" target="&quot;BEEKEEPING&quot;">
      <data key="d4">5.0</data>
      <data key="d5">"A wheelbarrow (or wagon) is suggested as a cart to hold spare supers during the beekeeping process."</data>
      <data key="d6">chunk-92090c6a7f40e420c9b8e4d961a9a21b</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TWO-STORY, TEN-FRAME HIVE&quot;" target="&quot;BOTTOM BOARD&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The bottom board is a component part of the two-story, ten-frame hive configuration."</data>
      <data key="d6">chunk-0a230cf3f43e673f8797237bc5d97548</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TWO-STORY, TEN-FRAME HIVE&quot;" target="&quot;HIVE BODIES&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The two-story hive configuration consists of two full-depth hive bodies."</data>
      <data key="d6">chunk-0a230cf3f43e673f8797237bc5d97548</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TWO-STORY, TEN-FRAME HIVE&quot;" target="&quot;FRAMES&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Frames are housed within the hive bodies of the two-story hive configuration."</data>
      <data key="d6">chunk-0a230cf3f43e673f8797237bc5d97548</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TWO-STORY, TEN-FRAME HIVE&quot;" target="&quot;FOUNDATION&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Foundation is used within the frames of the two-story hive configuration."</data>
      <data key="d6">chunk-0a230cf3f43e673f8797237bc5d97548</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TWO-STORY, TEN-FRAME HIVE&quot;" target="&quot;SUPPORT PINS&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Support pins are used to hold the foundation within the frames of the hive."</data>
      <data key="d6">chunk-0a230cf3f43e673f8797237bc5d97548</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TWO-STORY, TEN-FRAME HIVE&quot;" target="&quot;INNER COVER&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The inner cover is a component of the complete two-story hive."</data>
      <data key="d6">chunk-0a230cf3f43e673f8797237bc5d97548</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TWO-STORY, TEN-FRAME HIVE&quot;" target="&quot;OUTER COVER&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The outer cover is a component of the complete two-story hive."</data>
      <data key="d6">chunk-0a230cf3f43e673f8797237bc5d97548</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;BOTTOM BOARD&quot;" target="&quot;THE HIVE&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"The bottom board is a specific component of the hive structure."</data>
      <data key="d6">chunk-91fddbed5da654e2156cc50a2222b4ed</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE BODIES&quot;" target="&quot;BEE EQUIPMENT&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"Hive bodies are a specific type of bee equipment typically made of pine, cypress, or cedar."</data>
      <data key="d6">chunk-58530be97ce8bec48257c2ee46f928b4</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE BODIES&quot;" target="&quot;LATEX PAINTS&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Latex paints are recommended for painting hive bodies because they are less toxic and allow moisture to pass."</data>
      <data key="d6">chunk-58530be97ce8bec48257c2ee46f928b4</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE BODIES&quot;" target="&quot;OIL-BASED PAINT&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Oil-based paint is discouraged for hive bodies as it tends to crack and peel due to heat and moisture."</data>
      <data key="d6">chunk-58530be97ce8bec48257c2ee46f928b4</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;FRAMES&quot;" target="&quot;THE HIVE&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"Frames are essential internal components of the hive that hold the foundation and comb."</data>
      <data key="d6">chunk-91fddbed5da654e2156cc50a2222b4ed</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;FRAMES&quot;" target="&quot;FOUNDATION&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Frames and foundation must be compatible with each other to prevent buckling and bending."</data>
      <data key="d6">chunk-91fddbed5da654e2156cc50a2222b4ed</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;FOUNDATION&quot;" target="&quot;THE HIVE&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"Foundation is placed within the hive frames for the bees to build upon."</data>
      <data key="d6">chunk-91fddbed5da654e2156cc50a2222b4ed</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;FOUNDATION&quot;" target="&quot;HIVE BODY&quot;">
      <data key="d4">17.0</data>
      <data key="d5">"The foundation is located within the hive bodies and must be drawn out by the bees."&lt;SEP&gt;"The second hive body contains ten frames of foundation to allow the colony to expand."</data>
      <data key="d6">chunk-b902e3da084c9ce16ad8c497c00c21e2&lt;SEP&gt;chunk-50100ec9bbd638fb693fc24eeb2b3110</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;FOUNDATION&quot;" target="&quot;NECTAR FLOW&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"A nectar flow must be in progress for bees to draw out the foundation; without it, foundation may be ignored or removed."</data>
      <data key="d6">chunk-96d3190b056360cfac9d6ae0c079078e</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;FOUNDATION&quot;" target="&quot;BEEKEEPING&quot;">
      <data key="d4">16.0</data>
      <data key="d5">"Beekeepers use foundation within frames to encourage bees to build comb."&lt;SEP&gt;"Foundation is used by beekeepers to encourage bees to build straight combs."</data>
      <data key="d6">chunk-caeb5d2bd49a72e7116025708c05e9f6&lt;SEP&gt;chunk-59256e1e091228ca7c65d0b5d8fb2348</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;FOUNDATION&quot;" target="&quot;BEKEEPER&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Beekeepers place foundation in hives to be drawn into comb by the bees, often timed with honey flows."</data>
      <data key="d6">chunk-f2e066e2a68f225f5ecf3fa2f5d02bd8</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;INNER COVER&quot;" target="&quot;INSULATION BOARD&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The insulation board is placed over a reversed inner cover to create an upper entrance and keep the hive warm."</data>
      <data key="d6">chunk-27f6271ed08f494278ee4aa9601556c4</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;INNER COVER&quot;" target="&quot;OUTER COVER&quot;">
      <data key="d4">15.0</data>
      <data key="d5">"Both are components of the hive structure used in conjunction with insulation to manage ventilation and temperature."&lt;SEP&gt;"Insulation is placed between the inner cover and outer cover to prevent moisture from freezing and dripping on bees."</data>
      <data key="d6">chunk-27f6271ed08f494278ee4aa9601556c4&lt;SEP&gt;chunk-1de5be48f8b86dabc08e5087f75750aa</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;INNER COVER&quot;" target="&quot;TOP BAR HIVE&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"The inner cover is used in conjunction with hives, including top bar hives, to check for levelness."</data>
      <data key="d6">chunk-59256e1e091228ca7c65d0b5d8fb2348</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;INNER COVER&quot;" target="&quot;BEEKEEPING&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The inner cover is a piece of beekeeping equipment used for ventilation, feeding, and maintaining bee space."</data>
      <data key="d6">chunk-59256e1e091228ca7c65d0b5d8fb2348</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;INNER COVER&quot;" target="&quot;ESCAPE BOARD&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"The author prefers using an escape board over a bee escape in conjunction with their specific inner cover setup."</data>
      <data key="d6">chunk-e9b2fa060b49dfcd9523440966c974ac</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;INNER COVER&quot;" target="&quot;BEE ESCAPE&quot;">
      <data key="d4">5.0</data>
      <data key="d5">"The author discusses the inner cover's hole in the context of choosing between a bee escape and an escape board."</data>
      <data key="d6">chunk-e9b2fa060b49dfcd9523440966c974ac</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;INNER COVER&quot;" target="&quot;APIARY&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Inner covers are part of the hive structure in an apiary, sometimes featuring notches to provide upper entrances for ventilation."</data>
      <data key="d6">chunk-1de5be48f8b86dabc08e5087f75750aa</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;OUTER COVER&quot;" target="&quot;INSULATION BOARD&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The insulation board is positioned under the outer cover, and the outer cover is propped up to allow airflow across the top of the board."</data>
      <data key="d6">chunk-27f6271ed08f494278ee4aa9601556c4</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;OUTER COVER&quot;" target="&quot;APIARY&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Outer covers are used in apiaries to protect hives from precipitation and may be weighed down or strapped to prevent them from being blown away."</data>
      <data key="d6">chunk-1de5be48f8b86dabc08e5087f75750aa</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE STAND&quot;" target="&quot;THE HIVE&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The hive stand is a piece of necessary equipment used to support the hive."</data>
      <data key="d6">chunk-91fddbed5da654e2156cc50a2222b4ed</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE STAND&quot;" target="&quot;PINE&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The text mentions that conventional hive stands are usually made of pine."</data>
      <data key="d6">chunk-2a7084302d57591ff02e89969b4c3abd</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;FEEDER&quot;" target="&quot;BEEKEEPING&quot;">
      <data key="d4">15.0</data>
      <data key="d5">"Feeders are used in beekeeping to provide sustenance to bees, particularly in cool weather."&lt;SEP&gt;"The feeder is listed as necessary equipment for the practice of beekeeping."</data>
      <data key="d6">chunk-91fddbed5da654e2156cc50a2222b4ed&lt;SEP&gt;chunk-f11f928b6b6595520556e61b690ad234</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;FEEDER&quot;" target="&quot;BOARDMAN FEEDER&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"The Boardman feeder is a specific style of feeder commonly included in beginner beekeeping outfits."</data>
      <data key="d6">chunk-f11f928b6b6595520556e61b690ad234</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;FEEDER&quot;" target="&quot;HIVE BODY&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The feeder provides syrup to the bees inside the hive body and is removed when the hive is expanded."</data>
      <data key="d6">chunk-50100ec9bbd638fb693fc24eeb2b3110</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;VEIL AND HELMET&quot;" target="&quot;BEEKEEPING&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Veil and helmet are necessary protective gear for beekeeping."</data>
      <data key="d6">chunk-91fddbed5da654e2156cc50a2222b4ed</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;GLOVES&quot;" target="&quot;BEEKEEPING&quot;">
      <data key="d4">14.0</data>
      <data key="d5">"Gloves are listed as optional protective equipment for beekeeping."&lt;SEP&gt;"Gloves are mentioned as protective gear for the beekeeper."</data>
      <data key="d6">chunk-91fddbed5da654e2156cc50a2222b4ed&lt;SEP&gt;chunk-f11f928b6b6595520556e61b690ad234</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;GLOVES&quot;" target="&quot;BEE SUIT&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Both are listed as part of the conventional protective clothing worn by beekeepers."</data>
      <data key="d6">chunk-3d621a8bb4b7eb07600bbbfbdafcad0b</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;COVERALLS&quot;" target="&quot;BEEKEEPING&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Coveralls are listed as optional protective equipment for beekeeping."</data>
      <data key="d6">chunk-91fddbed5da654e2156cc50a2222b4ed</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;WIRING&quot;" target="&quot;PINS&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Both are described as methods for fastening the foundation into the frame, with pins being a simpler alternative to wiring."</data>
      <data key="d6">chunk-2a7084302d57591ff02e89969b4c3abd</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TELESCOPING OUTER COVER&quot;" target="&quot;VENTILATED INNER COVER&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Both are types of covers specified for the hive, often used together."</data>
      <data key="d6">chunk-2a7084302d57591ff02e89969b4c3abd</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TELESCOPING OUTER COVER&quot;" target="&quot;MIGRATORY COVER&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"The migratory cover is presented as an alternate cover style to the telescoping outer cover, used primarily by commercial beekeepers."</data>
      <data key="d6">chunk-2a7084302d57591ff02e89969b4c3abd</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;MIGRATORY COVER&quot;" target="&quot;VENTILATED INNER COVER&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The text states that a migratory cover is normally used without an inner cover."</data>
      <data key="d6">chunk-2a7084302d57591ff02e89969b4c3abd</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PLASTIC&quot;" target="&quot;MASONITE&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"Both are materials used to make covers, but are noted to sag compared to solid wood."</data>
      <data key="d6">chunk-2a7084302d57591ff02e89969b4c3abd</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PLASTIC&quot;" target="&quot;SOLID WOOD&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Solid wood is preferred over plastic for covers because it retains its shape better."</data>
      <data key="d6">chunk-2a7084302d57591ff02e89969b4c3abd</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PLASTIC&quot;" target="&quot;BEESWAX&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Plastic is used as a replacement for beeswax in hive foundations and combs, though bees generally prefer beeswax."</data>
      <data key="d6">chunk-0bfa52bca196a2a92c24daffb2347956</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PLASTIC&quot;" target="&quot;MISSISSIPPI RIVER&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Plastic factories located along the Mississippi River create polluted areas known as 'cancer alleys'."</data>
      <data key="d6">chunk-0bfa52bca196a2a92c24daffb2347956</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PLASTIC&quot;" target="&quot;AMERICAN FOULBROOD DISEASE&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"When a hive with plastic frames is infected with American foulbrood disease, it must be burned, releasing deadly toxins."</data>
      <data key="d6">chunk-0bfa52bca196a2a92c24daffb2347956</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PLASTIC&quot;" target="&quot;STYROFOAM&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Styrofoam is identified as another form of plastic used in hive construction."</data>
      <data key="d6">chunk-0bfa52bca196a2a92c24daffb2347956</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PLASTIC&quot;" target="&quot;VIRGIN AUSTRALIA&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The author criticizes Virgin Australia for the excessive use of plastic packaging and cups during the flight."</data>
      <data key="d6">chunk-b6960fa545678f7ef098947fd99e7d73</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PLASTIC&quot;" target="&quot;LAPTOP&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"The author expresses concern about plastic waste showering down onto their laptop."</data>
      <data key="d6">chunk-b6960fa545678f7ef098947fd99e7d73</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;MASONITE&quot;" target="&quot;SOLID WOOD&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Solid wood is preferred over masonite because it does not absorb as much moisture and retains its shape."</data>
      <data key="d6">chunk-2a7084302d57591ff02e89969b4c3abd</data>
