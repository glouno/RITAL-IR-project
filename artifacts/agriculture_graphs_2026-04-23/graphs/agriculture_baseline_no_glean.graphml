      <data key="d6">chunk-782950436a4bb61b4698327ee847a64b</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;RABBET PROTECTOR&quot;" target="&quot;BEEKEEPING&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Rabbet protectors are equipment used to protect the frame rest area in beekeeping hives."</data>
      <data key="d6">chunk-59256e1e091228ca7c65d0b5d8fb2348</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TOP BAR HIVE&quot;" target="&quot;BEEKEEPING&quot;">
      <data key="d4">18.0</data>
      <data key="d5">"The top bar hive is a specific type of equipment used within the general practice of beekeeping."&lt;SEP&gt;"Top bar hives are a specific type of hive structure used in beekeeping."</data>
      <data key="d6">chunk-59256e1e091228ca7c65d0b5d8fb2348&lt;SEP&gt;chunk-e9b2fa060b49dfcd9523440966c974ac</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TOP BAR HIVE&quot;" target="&quot;AMERICA&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The popularity of the top bar hive has grown significantly in America."</data>
      <data key="d6">chunk-e9b2fa060b49dfcd9523440966c974ac</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TOP BAR HIVE&quot;" target="&quot;UNITED STATES&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"There are commercial top bar operations consisting of 100 to 300 hives scattered across the United States."</data>
      <data key="d6">chunk-e9b2fa060b49dfcd9523440966c974ac</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TOP BAR HIVE&quot;" target="&quot;KENYAN TOP BAR HIVE&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Modern top bar hives are often shaped in the style of the Kenyan top bar hive."</data>
      <data key="d6">chunk-e9b2fa060b49dfcd9523440966c974ac</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TOP BAR HIVE&quot;" target="&quot;EUROPEAN HONEY BEES&quot;">
      <data key="d4">5.0</data>
      <data key="d5">"The author suggests the TBH may not be the best cavity shape for European honey bees, who prefer vertical work."</data>
      <data key="d6">chunk-b13bef129d93b5a27e008dbee0931310</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TOP BAR HIVE&quot;" target="&quot;AFRICAN HONEY BEE&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The TBH shape may be perfect for the African honey bee due to its habits and climate."</data>
      <data key="d6">chunk-b13bef129d93b5a27e008dbee0931310</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TOP BAR HIVE&quot;" target="&quot;AFRICA&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"The TBH is ideal for and widely used in rural Africa due to the scarcity of lumber and simple tool requirements."</data>
      <data key="d6">chunk-b13bef129d93b5a27e008dbee0931310</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TOP BAR HIVE&quot;" target="&quot;TOP BAR&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"A top bar hive is a specific type of hive that utilizes top bars instead of full frames."</data>
      <data key="d6">chunk-39baafb5b073ac43e9932248ea8ca932</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;KENYAN TOP BAR HIVE&quot;" target="&quot;GUELPH, ONTARIO&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"The Kenyan top bar hive was developed by a research team from Guelph, Ontario in the 1970s."</data>
      <data key="d6">chunk-e9b2fa060b49dfcd9523440966c974ac</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;KENYAN TOP BAR HIVE&quot;" target="&quot;TBH&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"The Kenyan top bar hive is presented as a specific example of a TBH."</data>
      <data key="d6">chunk-80cb5b40207cce260add50ac65980ec6</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;EUROPEAN HONEY BEES&quot;" target="&quot;NORTH AMERICA&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"The text discusses the suitability of hive shapes for European honey bees located in North America."</data>
      <data key="d6">chunk-b13bef129d93b5a27e008dbee0931310</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;EUROPEAN HONEY BEES&quot;" target="&quot;EUROPE&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"The text discusses the suitability of hive shapes for European honey bees located in Europe."</data>
      <data key="d6">chunk-b13bef129d93b5a27e008dbee0931310</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;EUROPEAN HONEY BEES&quot;" target="&quot;AFRICAN CAPE HONEY BEE&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"European honey bees mimic the confinement and absconding behaviors of the African Cape honey bee to tolerate beetle infestations."</data>
      <data key="d6">chunk-22d3d1f02012460a93c378c764a2e09d</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;EUROPEAN HONEY BEES&quot;" target="&quot;AETHINA TUMIDA&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"European honey bees are affected by Aethina tumida infestations and employ various strategies to tolerate or escape them."</data>
      <data key="d6">chunk-22d3d1f02012460a93c378c764a2e09d</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TBH&quot;" target="&quot;FOLLOWER BOARD&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Follower boards are used in TBHs to adjust the hive cavity size and restrict colony access to specific areas to limit cross-comb."</data>
      <data key="d6">chunk-a5250b34c6030902898b14ec6202d48c</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TBH&quot;" target="&quot;JAR FEEDER&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"A jar feeder can be placed in a TBH, often used in conjunction with a follower board to allow bee access."</data>
      <data key="d6">chunk-a5250b34c6030902898b14ec6202d48c</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TBH&quot;" target="&quot;KTBH&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The KTBH is a specific type of top bar hive that influences the resulting shape of the comb."</data>
      <data key="d6">chunk-a5250b34c6030902898b14ec6202d48c</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TBH&quot;" target="&quot;LANGSTROTH FRAME&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The TBH (Top Bar Hive) is repeatedly compared to the Langstroth hive/frame in terms of manipulation, inspection speed, and management habits."</data>
      <data key="d6">chunk-80cb5b40207cce260add50ac65980ec6</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TBH&quot;" target="&quot;INDUSTRIAL MODEL OF BEEKEEPING&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The TBH is described as an alternative and a clear break from the industrial model of beekeeping."</data>
      <data key="d6">chunk-80cb5b40207cce260add50ac65980ec6</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TBH&quot;" target="&quot;ITALIAN HONEY BEE&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The Italian honey bee is described as not being a good candidate for the TBH unless the beekeeper has significant experience."</data>
      <data key="d6">chunk-80cb5b40207cce260add50ac65980ec6</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TBH&quot;" target="&quot;VERMONT&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Vermont is cited as an example of a northern climate where specific brood and honey placement is important within a TBH."</data>
      <data key="d6">chunk-80cb5b40207cce260add50ac65980ec6</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TBH&quot;" target="&quot;KENYAN-STYLE RAILS&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The author suggests adding Kenyan-style rails to TBHs to provide handles for moving the hive and a place to hang frames."</data>
      <data key="d6">chunk-8e06b0074dff6e9083043d922831e71f</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;FOLLOWER BOARD&quot;" target="&quot;JAR FEEDER&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"A follower board is positioned between the feeder and the rest of the hive, with a hole drilled to allow bees to access the feed."</data>
      <data key="d6">chunk-a5250b34c6030902898b14ec6202d48c</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;KTBH&quot;" target="&quot;CATENARY CURVE&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The comb shape in a KTBH is noted to be closer to the natural oval shape known as a catenary curve."</data>
      <data key="d6">chunk-a5250b34c6030902898b14ec6202d48c</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;CATENARY CURVE&quot;" target="&quot;LANGSTROTH FRAME&quot;">
      <data key="d4">5.0</data>
      <data key="d5">"The text compares the catenary curve shape of natural comb to the rectangular shape of a Langstroth frame."</data>
      <data key="d6">chunk-80cb5b40207cce260add50ac65980ec6</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;LANGSTROTH FRAME&quot;" target="&quot;INDUSTRIAL MODEL OF BEEKEEPING&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"While Langstroth hives are often associated with the industrial model, the text notes that some beekeepers use them without following that model."</data>
      <data key="d6">chunk-80cb5b40207cce260add50ac65980ec6</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;CHAMPLAIN VALLEY APIARIES&quot;" target="&quot;MRAZ FAMILY&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The Mraz family is associated with Champlain Valley Apiaries, where they mentored the author in beekeeping."</data>
      <data key="d6">chunk-3fe7c71f0a95e2aad6e89fc32c4e429f</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;BEE BREAD&quot;" target="&quot;POLLEN SUBSTITUTES&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Pollen substitutes are contrasted with bee bread; the former cannot support symbiotic bacteria that thrive on the latter."</data>
      <data key="d6">chunk-6bb5ed2e7521db41a82dfc5b79b8b701</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HYDROXYMETHYLFURFURAL (HMF)&quot;" target="&quot;HIGH-FRUCTOSE CORN SYRUP (HFCS)&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Heating HFCS produces HMF, with concentrations increasing dramatically at temperatures of 120°F and higher."</data>
      <data key="d6">chunk-cfec606648bbeb5ca28bfc5c7e8323a7</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIGH-FRUCTOSE CORN SYRUP (HFCS)&quot;" target="&quot;BACILLUS THURINGIENSIS (BT)&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"HFCS is derived from corn grown in the US that is genetically modified to produce the Bt toxin."</data>
      <data key="d6">chunk-cfec606648bbeb5ca28bfc5c7e8323a7</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIGH-FRUCTOSE CORN SYRUP (HFCS)&quot;" target="&quot;MERCURY&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Studies have found toxic levels of mercury in many samples of HFCS, likely stemming from the chemicals used in its production."</data>
      <data key="d6">chunk-cfec606648bbeb5ca28bfc5c7e8323a7</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIGH-FRUCTOSE CORN SYRUP (HFCS)&quot;" target="&quot;UNITED STATES&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"HFCS is a major part of the diet for humans and honey bees dwelling in the United States."</data>
      <data key="d6">chunk-cfec606648bbeb5ca28bfc5c7e8323a7</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;BACILLUS THURINGIENSIS (BT)&quot;" target="&quot;BIOTECH INDUSTRY&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The biotech industry touts the engineering of the Bt toxin into crops as a beneficial use of genetic engineering."</data>
      <data key="d6">chunk-bac18720725e6cd5a486707a79f3f616</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;BACILLUS THURINGIENSIS (BT)&quot;" target="&quot;EUROPEAN CORN BORER&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The European corn borer is a target pest exposed to lethal doses of the Bt toxin in genetically modified corn."</data>
      <data key="d6">chunk-bac18720725e6cd5a486707a79f3f616</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HFCS&quot;" target="&quot;HYDROCHLORIC ACID&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Hydrochloric acid is identified as a potential source of mercury contamination used in the production of HFCS."</data>
      <data key="d6">chunk-a78d99903600ffa6f92d29953bed6a52</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HFCS&quot;" target="&quot;CAUSTIC SODA&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Caustic soda is identified as a potential source of mercury contamination used in the production of HFCS."</data>
      <data key="d6">chunk-a78d99903600ffa6f92d29953bed6a52</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HFCS&quot;" target="&quot;US CORN REFINERS ASSOCIATION&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The US Corn Refiners Association promotes HFCS and attempts to refute negative studies regarding its safety."</data>
      <data key="d6">chunk-a78d99903600ffa6f92d29953bed6a52</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HFCS&quot;" target="&quot;D-FRUCTOSE&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"The fructose found in HFCS is specifically identified as D-fructose."</data>
      <data key="d6">chunk-a78d99903600ffa6f92d29953bed6a52</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HFCS&quot;" target="&quot;BEE TEA&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Bee tea is contrasted with HFCS as a superior alternative for preventing starvation and boosting the immune system."</data>
      <data key="d6">chunk-d8e8d4cc911657d6fdf8ff1c7e34b598</data>
      <data key="d7">1</data>
    </edge>
