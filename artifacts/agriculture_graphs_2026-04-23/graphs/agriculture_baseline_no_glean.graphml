      <data key="d6">chunk-c29c8fc62f2aad355ff0f1407fba86a8</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;STONE-AGE PEOPLE&quot;" target="&quot;BEEKEEPING&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Stone-Age people are considered the first beekeepers, having kept bees in some manner."</data>
      <data key="d6">chunk-96f78f364d74eca8b91a5a10f5f9de4b</data>
      <data key="d7">1</data>
    </edge>
