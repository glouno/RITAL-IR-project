      <data key="d4">8.0</data>
      <data key="d5">"The cultivator uses autoclaving to reduce the population of contaminants in the supplemented sawdust blocks."</data>
      <data key="d6">chunk-36c513728ad8ea58b3b658cb85d90f8e</data>
      <data key="d7">1</data>
    </edge>
