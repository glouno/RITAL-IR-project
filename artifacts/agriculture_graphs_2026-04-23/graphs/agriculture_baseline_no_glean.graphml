      <data key="d4">20.0</data>
      <data key="d5">"M. Latteur is a Veterinary Inspector for the Belgian Ministry of Agriculture."&lt;SEP&gt;"M. Latteur serves as the Veterinary Inspector of the Belgian Ministry of Agriculture."</data>
      <data key="d6">chunk-6ae2c3c06185787a0960e3e64c56f15b&lt;SEP&gt;chunk-e15abe44b0e95afa45dd19faa53ac41e</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;M. LATTEUR&quot;" target="&quot;NON-PROTEIN NITROGEN&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"M. Latteur posits that the excess ammonia leading to grass tetany is a result of massive dressings of non-protein nitrogen."</data>
      <data key="d6">chunk-6ae2c3c06185787a0960e3e64c56f15b</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;M. LATTEUR&quot;" target="&quot;UREA&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"M. Latteur explains the biological process where the liver converts toxic ammonia into urea for excretion."</data>
      <data key="d6">chunk-6ae2c3c06185787a0960e3e64c56f15b</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;NON-PROTEIN NITROGEN&quot;" target="&quot;UREA&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"Non-protein nitrogen is resorbed as ammonia, which the liver then converts into urea to be rendered harmless."</data>
      <data key="d6">chunk-6ae2c3c06185787a0960e3e64c56f15b</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;NORTHWEST EUROPE&quot;" target="&quot;RATIONAL GRAZING&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"The text discusses optimum rest periods for grass re-growth specifically under average conditions in NorthWest Europe within the context of rational grazing laws."</data>
      <data key="d6">chunk-ed80c461fcd7ae24e2d82990c8272a1b</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;LEY FARMING&quot;" target="&quot;GREAT BRITAIN&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Ley farming is specifically identified as a method used in Great Britain."</data>
      <data key="d6">chunk-05374d444d89278cd804bde3807b7797</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;LUCERNE&quot;" target="&quot;RATIONAL GRAZING&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The author uses lucerne as an analogy to explain the drop in yield that occurs when grazing/cutting intervals are too short, comparing it to the results of rational grazing."</data>
      <data key="d6">chunk-ed80c461fcd7ae24e2d82990c8272a1b</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THE FIRST UNIVERSAL LAW&quot;" target="&quot;RATIONAL GRAZING&quot;">
      <data key="d4">16.0</data>
      <data key="d5">"The First Law is one of the four Universal Laws that derive from the principle directing rational grazing."&lt;SEP&gt;"The First Universal Law is credited with determining the colossal increases in yield obtained from rational grazing."</data>
      <data key="d6">chunk-a574c5769e1eacad6df009d4dcc7dfc2</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THE FIRST UNIVERSAL LAW&quot;" target="&quot;THE SECOND LAW&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The Second Law is stated to derive from the First Law."</data>
      <data key="d6">chunk-a574c5769e1eacad6df009d4dcc7dfc2</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THE SECOND LAW&quot;" target="&quot;RATIONAL GRAZING&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The Second Law is one of the four Universal Laws that derive from the principle directing rational grazing."</data>
      <data key="d6">chunk-a574c5769e1eacad6df009d4dcc7dfc2</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THE THIRD LAW&quot;" target="&quot;THE FOURTH LAW&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"The Fourth Law's effect on milk yield is described as a result of the Third Law, as a bare sward reduces grass quality and quantity."</data>
      <data key="d6">chunk-a574c5769e1eacad6df009d4dcc7dfc2</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THE THIRD LAW&quot;" target="&quot;RATIONAL GRAZING&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The Third Law is one of the four Universal Laws that derive from the principle directing rational grazing."</data>
      <data key="d6">chunk-a574c5769e1eacad6df009d4dcc7dfc2</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THE FOURTH LAW&quot;" target="&quot;RATIONAL GRAZING&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The Fourth Law is one of the four Universal Laws that derive from the principle directing rational grazing."</data>
      <data key="d6">chunk-a574c5769e1eacad6df009d4dcc7dfc2</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;FIRST LAW&quot;" target="&quot;UNIVERSAL LAWS&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The First Law is one of the four Universal Laws that govern rational grazing."</data>
      <data key="d6">chunk-27f7fce25d74a4f961f260af1c936fff</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;UNIVERSAL LAWS&quot;" target="&quot;RATIONAL GRAZING&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The four Universal Laws derive from one great principle that directs rational grazing."</data>
      <data key="d6">chunk-27f7fce25d74a4f961f260af1c936fff</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;WARMBOLD SYSTEM&quot;" target="&quot;RATIONAL GRAZING&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The Warmbold system is listed as one of the many different names applied to intensive or rational grazing."</data>
      <data key="d6">chunk-27f7fce25d74a4f961f260af1c936fff</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;KÖNEKAMP&quot;" target="&quot;RATIONAL GRAZING&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"Könekamp is identified as a German pioneer of rotation whose work helped inform the definitions and principles of rational grazing."</data>
      <data key="d6">chunk-27f7fce25d74a4f961f260af1c936fff</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;ANIMAL UNIT&quot;" target="&quot;RATIONAL GRAZING&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The animal unit is a defined measure used to simplify calculations and judge the productivity of pastures within rational grazing systems."</data>
      <data key="d6">chunk-27f7fce25d74a4f961f260af1c936fff</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;ANIMAL UNIT&quot;" target="&quot;COW-DAYS&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Cow-days are defined as animal units grazing days, where the production of a sward is represented by the number of animal units multiplied by the days grazed."</data>
      <data key="d6">chunk-659e8a1d0c3ea0d7149e2c946a891e09</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;ANIMAL UNIT&quot;" target="&quot;LIVESTOCK CARRY&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Livestock carry is defined as the number of animal units (or living weight) supported on average by one acre or hectare of pasture."</data>
      <data key="d6">chunk-659e8a1d0c3ea0d7149e2c946a891e09</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;ANIMAL UNIT&quot;" target="&quot;STOCKING DENSITY&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Stocking density is defined as the number of animal units (or meat weight) supported by the total area of the paddock being grazed simultaneously."</data>
      <data key="d6">chunk-659e8a1d0c3ea0d7149e2c946a891e09</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;COW-DAYS&quot;" target="&quot;RATIONAL GRAZING&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Cow-days is a simplified method of calculating pasture productivity in the context of rational grazing."</data>
      <data key="d6">chunk-6cd47d3de7f87ca5f9d415c2e16ce46f</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;COW-DAYS&quot;" target="&quot;ANIMAL UNIT GRAZING DAYS&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Animal unit grazing days and cow-days are presented as equivalent or interchangeable measures of pasture production."</data>
      <data key="d6">chunk-6cd47d3de7f87ca5f9d415c2e16ce46f</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;LIVESTOCK CARRY&quot;" target="&quot;STOCKING DENSITY&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Stocking density is described as the 'instantaneous livestock carry' or the livestock-carry of the total area of the paddocks being grazed simultaneously."</data>
      <data key="d6">chunk-659e8a1d0c3ea0d7149e2c946a891e09</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;LIVESTOCK CARRY&quot;" target="&quot;RATIONAL GRAZING&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Rational grazing, specifically with a 1-day period of stay, allows for a higher livestock carry compared to longer stay periods."</data>
      <data key="d6">chunk-418420d01189e0b2be4207485e8eabea</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;LIVESTOCK CARRY&quot;" target="&quot;NITROGEN DRESSINGS&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The application of nitrogen dressings increases livestock carry, a benefit specifically enabled by rational grazing."</data>
      <data key="d6">chunk-418420d01189e0b2be4207485e8eabea</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;STOCKING DENSITY&quot;" target="&quot;BESATZDICHTE&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"Stocking density is the English translation of the German term 'Besatzdichte'."</data>
      <data key="d6">chunk-659e8a1d0c3ea0d7149e2c946a891e09</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;STOCKING DENSITY&quot;" target="&quot;INTENSITY OF GRAZING&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"The intensity of grazing is obtained by multiplying the stocking density by the period of occupation."</data>
      <data key="d6">chunk-2c6be08cda7aded7207a29a510cfd328</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PERIOD OF STAY&quot;" target="&quot;PERIOD OF OCCUPATION&quot;">
      <data key="d4">20.0</data>
      <data key="d5">"The period of occupation is the sum of the periods of stay of individual groups; if stay is uniform, it is the period of stay multiplied by the number of groups."&lt;SEP&gt;"The period of occupation is the total time a paddock is grazed, which is equal to the total of the periods of stay of the individual groups."</data>
      <data key="d6">chunk-2c6be08cda7aded7207a29a510cfd328&lt;SEP&gt;chunk-659e8a1d0c3ea0d7149e2c946a891e09</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PERIOD OF STAY&quot;" target="&quot;REST PERIOD&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The rest period is determined by the period of stay multiplied by the number of resting paddocks."</data>
      <data key="d6">chunk-2c6be08cda7aded7207a29a510cfd328</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PERIOD OF OCCUPATION&quot;" target="&quot;REST PERIOD&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The period of occupation is subtracted from the total rotation time to determine the period of rest."</data>
      <data key="d6">chunk-2c6be08cda7aded7207a29a510cfd328</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PERIOD OF OCCUPATION&quot;" target="&quot;INTENSITY OF GRAZING&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"For a constant stocking density, the intensity of grazing varies proportionally with the period of occupation."</data>
      <data key="d6">chunk-2c6be08cda7aded7207a29a510cfd328</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;INTENSITY OF GRAZING&quot;" target="&quot;VOISIN&quot;">
      <data key="d4">19.0</data>
      <data key="d5">"Voisin defined the term 'intensity of grazing' to provide a more accurate measure than stocking density."&lt;SEP&gt;"Voisin developed the unit 'intensity of grazing' and provides mathematical demonstrations for its application."</data>
      <data key="d6">chunk-2c6be08cda7aded7207a29a510cfd328&lt;SEP&gt;chunk-0169a1c039e632cea63d0b0e23a7089d</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;INTENSITY OF GRAZING&quot;" target="&quot;BESATZLEISTUNG&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Besatzleistung is a unit analogous to the intensity of grazing, both taking into account stocking density and time."</data>
      <data key="d6">chunk-0169a1c039e632cea63d0b0e23a7089d</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;INTENSITY OF GRAZING&quot;" target="&quot;AGRICULTURAL ADVISERS' SERVICE&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"The author suggests that the complexity of 'intensity of grazing' (and Besatzleistung) makes them too complicated for use in the agricultural advisers' service."</data>
      <data key="d6">chunk-0169a1c039e632cea63d0b0e23a7089d</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;INTENSITY OF GRAZING&quot;" target="&quot;RATIONAL GRAZING PLAN&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The understanding of intensity of grazing and the factor of time is essential for the progress and implementation of a rational grazing plan."</data>
      <data key="d6">chunk-0169a1c039e632cea63d0b0e23a7089d</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;LAWS OF RATIONAL GRAZING&quot;" target="&quot;RATIONAL GRAZING&quot;">
      <data key="d4">20.0</data>
      <data key="d5">"The Laws of Rational Grazing provide the theoretical framework and guidelines for the conduct of rational grazing management."&lt;SEP&gt;"The Laws of Rational Grazing provide the theoretical framework and requirements (such as stay and occupation periods) to ensure the success and efficiency of a rational grazing system."</data>
      <data key="d6">chunk-6f09c1defaf6c7013ba4ecd1cac40b5a&lt;SEP&gt;chunk-0bee7d5fac9dd017be636b45597ba373</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SCHUPPLI SYSTEM&quot;" target="&quot;RATIONAL GRAZING&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The Schuppli system is referenced as another system of grazing to be analyzed in relation to the principles of rational grazing."</data>
      <data key="d6">chunk-0bee7d5fac9dd017be636b45597ba373</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SCHUPPLI SYSTEM&quot;" target="&quot;UNIVERSAL LAWS OF RATIONAL GRAZING&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The Schuppli system is analyzed based on its adherence to the Universal Laws of Rational Grazing, specifically regarding occupation and rest periods."</data>
      <data key="d6">chunk-e8df78d16e962e8d1ecc294f9d88aaa9</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SCHUPPLI SYSTEM&quot;" target="&quot;SCHUPPLI&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"Schuppli is the creator and descriptor of the grazing system known as the Schuppli system."</data>
      <data key="d6">chunk-de51cda9d4527990e36f2dadce1bd2c5</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SCHUPPLI SYSTEM&quot;" target="&quot;PROFESSOR CAPUTA&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"Professor Caputa provides a version or restatement of the position regarding the Schuppli system."</data>
      <data key="d6">chunk-de51cda9d4527990e36f2dadce1bd2c5</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SCHUPPLI SYSTEM&quot;" target="&quot;FARMER&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"The text discusses how farmers using rotational systems, potentially like the Schuppli system, face risks of stock health issues like rumination failure."</data>
      <data key="d6">chunk-92e328d3b527b1888b7f5192459a3b01</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;GERMAN PIONEERS OF ROTATIONAL GRAZING&quot;" target="&quot;HIGH YIELDING DAIRY COWS&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The German pioneers recommended dividing the herd into groups, designating high yielding dairy cows as Group 1."</data>
      <data key="d6">chunk-e8df78d16e962e8d1ecc294f9d88aaa9</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;GERMAN PIONEERS OF ROTATIONAL GRAZING&quot;" target="&quot;LOW YIELDING DAIRY COWS&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The German pioneers recommended dividing the herd into groups, designating low yielding dairy cows as Group 2."</data>
      <data key="d6">chunk-e8df78d16e962e8d1ecc294f9d88aaa9</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;GERMAN PIONEERS OF ROTATIONAL GRAZING&quot;" target="&quot;DRY COWS, CALVES, FOALS, SHEEP&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The German pioneers recommended dividing the herd into groups, designating dry cows, calves, foals, and sheep as Group 3."</data>
      <data key="d6">chunk-e8df78d16e962e8d1ecc294f9d88aaa9</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIGH YIELDING DAIRY COWS&quot;" target="&quot;THIRD LAW&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The Third Law dictates that animals with the greatest nutritive requirements, such as high yielders, should be positioned to harvest the greatest quantity of grass."</data>
      <data key="d6">chunk-e8df78d16e962e8d1ecc294f9d88aaa9</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TESSIER&quot;" target="&quot;ANGERVILLE&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Tessier was born in Angerville."</data>
      <data key="d6">chunk-f11bd11cdae96ea0e8cfc407a935884e</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TESSIER&quot;" target="&quot;SEINE-ET-OISE&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Tessier was born in Angerville, which is located in Seine-et-Oise."</data>
      <data key="d6">chunk-f11bd11cdae96ea0e8cfc407a935884e</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TESSIER&quot;" target="&quot;ACADÉMIE DES SCIENCES&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Tessier became a member of the Académie des Sciences in 1783."</data>
      <data key="d6">chunk-f11bd11cdae96ea0e8cfc407a935884e</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TESSIER&quot;" target="&quot;ÉTABLISSEMENT RURAL DE RAMBOUILLET&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"Tessier served as the Director of the Établissement Rural de Rambouillet."</data>
      <data key="d6">chunk-f11bd11cdae96ea0e8cfc407a935884e</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TESSIER&quot;" target="&quot;THOUIN&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Tessier and Thouin were colleagues and co-authors of the Methodical Encyclopcedia of Agriculture."</data>
      <data key="d6">chunk-f11bd11cdae96ea0e8cfc407a935884e</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TESSIER&quot;" target="&quot;BOSC&quot;">
      <data key="d4">8.0</data>
