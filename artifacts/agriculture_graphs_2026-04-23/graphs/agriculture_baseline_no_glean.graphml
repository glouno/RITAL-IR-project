      <data key="d4">8.0</data>
      <data key="d5">"The smoker is used as a tool to keep bees calm while working with them."</data>
      <data key="d6">chunk-e4c100bb043929fe5d53e4af2e279dfb</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SMOKER&quot;" target="&quot;SUPER&quot;">
      <data key="d4">7.0</data>
