      <data key="d4">8.0</data>
      <data key="d5">"Terramycin is an antibiotic used prophylactically in beekeeping to treat or prevent AFB."</data>
      <data key="d6">chunk-2a07d3f020711352b6c4bb16ca80f182</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;TERRAMYCIN&quot;" target="&quot;NOSEMA&quot;">
      <data key="d4">9.0</data>
