      <data key="d4">10.0</data>
      <data key="d5">"Drones develop from unfertilized eggs through the process of parthenogenesis."</data>
      <data key="d6">chunk-b9bf03b457112a6e1094db904efcfe2d</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THE WORKER&quot;" target="&quot;HOUSE BEE&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The house bee is one of the three developmental segments of a worker's life."</data>
      <data key="d6">chunk-b9bf03b457112a6e1094db904efcfe2d</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THE WORKER&quot;" target="&quot;FIELD BEE&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The field bee is the final developmental segment of a worker's life."</data>
      <data key="d6">chunk-b9bf03b457112a6e1094db904efcfe2d</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THE WORKER&quot;" target="&quot;NURSE BEES&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Worker larvae are fed royal jelly secreted from the glands of nurse bees."</data>
      <data key="d6">chunk-b9bf03b457112a6e1094db904efcfe2d</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PARTHENOGENESIS&quot;" target="&quot;EUROPEAN HONEY BEES&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Parthenogenesis is described as being extremely rare in European honey bees."</data>
      <data key="d6">chunk-82e31ea2adf95c6c787a2e0a6348bae1</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PARTHENOGENESIS&quot;" target="&quot;CAPE BEES&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Parthenogenesis is apparently more common in Cape bees."</data>
      <data key="d6">chunk-82e31ea2adf95c6c787a2e0a6348bae1</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PARTHENOGENESIS&quot;" target="&quot;QUEEN&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"Parthenogenesis is the process by which unfertilized bee eggs develop into queens."</data>
      <data key="d6">chunk-9654edf0284987ba4f0c8bde4acffe9b</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SPERMATHECA&quot;" target="&quot;MATING FLIGHTS&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The amount of sperm stored in the spermatheca is dependent upon the number of drones the queen mated with during her mating flights."</data>
      <data key="d6">chunk-bed6fe8d6b1e0689fd3080d94a55bcac</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HOUSE BEE&quot;" target="&quot;WORKER BEE&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"A worker bee spends a portion of her life span functioning as a house bee."</data>
      <data key="d6">chunk-78182a0a75dac1ecf9d9f1cc16f3a0ff</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HOUSE BEE&quot;" target="&quot;BROOD NEST&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The house bee is born in the brood nest and remains there for several days at the start of her life."</data>
      <data key="d6">chunk-78182a0a75dac1ecf9d9f1cc16f3a0ff</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HOUSE BEE&quot;" target="&quot;FIELD BEE&quot;">
      <data key="d4">23.0</data>
      <data key="d5">"A house bee graduates to become a field bee, transitioning from hive tasks to foraging."&lt;SEP&gt;"Field bees pass nectar to house bees and are apprised of the nectar's quality by the speed of unloading."&lt;SEP&gt;"The house bee phase includes orientation flights that prepare the bee for her future role as a field bee."</data>
      <data key="d6">chunk-6f51ec44f0c17ad5253b21395cf12591&lt;SEP&gt;chunk-65de87b95deadb72c4827d5a3bd2f316&lt;SEP&gt;chunk-78182a0a75dac1ecf9d9f1cc16f3a0ff</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HOUSE BEE&quot;" target="&quot;THE COLONY&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"House bees respond to the needs of the colony, sometimes maturing quickly to replace lost foragers."</data>
      <data key="d6">chunk-65de87b95deadb72c4827d5a3bd2f316</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HOUSE BEE&quot;" target="&quot;FORAGING&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"House bees process nectar brought in by foragers and signal its quality based on how eagerly they accept the load."</data>
      <data key="d6">chunk-6f51ec44f0c17ad5253b21395cf12591</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;FIELD BEE&quot;" target="&quot;WORKER BEE&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"A worker bee spends a portion of her life span functioning as a field bee after her phase as a house bee."</data>
      <data key="d6">chunk-78182a0a75dac1ecf9d9f1cc16f3a0ff</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;FIELD BEE&quot;" target="&quot;THE COLONY&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Field bees forage for raw materials required for colony life."</data>
      <data key="d6">chunk-65de87b95deadb72c4827d5a3bd2f316</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;FIELD BEE&quot;" target="&quot;INSECTICIDE&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Insecticides may be brought back to the hive by pollen foragers (field bees), affecting the colony."</data>
      <data key="d6">chunk-65de87b95deadb72c4827d5a3bd2f316</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;FIELD BEE&quot;" target="&quot;THE DANCE LANGUAGE&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Foragers (field bees) perform dances upon returning to the hive to recruit other potential foragers."</data>
      <data key="d6">chunk-6f51ec44f0c17ad5253b21395cf12591</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;WORKER BEE&quot;" target="&quot;NURSE BEE&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Nurse bees are a specialized role of worker bees that feed the larvae."</data>
      <data key="d6">chunk-14c389aa55b6d5b4c773f2c917b36e7a</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;WORKER BEE&quot;" target="&quot;QUEEN BEE&quot;">
      <data key="d4">16.0</data>
      <data key="d5">"Worker bees assist the queen by grooming and feeding her, and nurse bees tend to her specifically."&lt;SEP&gt;"Worker bees attend to the queen and perform all tasks necessary for the colony's success other than reproduction."</data>
      <data key="d6">chunk-14c389aa55b6d5b4c773f2c917b36e7a&lt;SEP&gt;chunk-43e80ed5175459c22df05858f37cc067</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;WORKER BEE&quot;" target="&quot;DRONE BEE&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"Workers raise drone replacements and may differ in their developmental timing and tasks compared to drones."</data>
      <data key="d6">chunk-14c389aa55b6d5b4c773f2c917b36e7a</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;WORKER BEE&quot;" target="&quot;HIVE&quot;">
      <data key="d4">18.0</data>
      <data key="d5">"Worker bees carry out various duties inside and outside the hive, including cleaning, nursing, and building combs."&lt;SEP&gt;"Workers spend the first half of their adult life as house bees within the hive and perform cleaning and maintenance tasks."</data>
      <data key="d6">chunk-14c389aa55b6d5b4c773f2c917b36e7a&lt;SEP&gt;chunk-43e80ed5175459c22df05858f37cc067</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;WORKER BEE&quot;" target="&quot;COLONY&quot;">
      <data key="d4">20.0</data>
      <data key="d5">"The worker bee is the primary life force of the colony, performing most of the tasks within and outside the hive."&lt;SEP&gt;"Workers perform all non-reproductive tasks essential for the success and survival of the colony."</data>
      <data key="d6">chunk-14c389aa55b6d5b4c773f2c917b36e7a&lt;SEP&gt;chunk-78182a0a75dac1ecf9d9f1cc16f3a0ff</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;WORKER BEE&quot;" target="&quot;PROPOLIS&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Worker bees forage for propolis and use it to strengthen the comb and seal cracks in the hive."</data>
      <data key="d6">chunk-14c389aa55b6d5b4c773f2c917b36e7a</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;WORKER BEE&quot;" target="&quot;QUEEN&quot;">
      <data key="d4">14.0</data>
      <data key="d5">"Worker bees deposit odors in empty cells to indicate to the queen that they are ready for eggs."&lt;SEP&gt;"Worker bees perform duties such as attending to the queen, though they cannot perform tasks exclusive to her."</data>
      <data key="d6">chunk-6f51ec44f0c17ad5253b21395cf12591&lt;SEP&gt;chunk-78182a0a75dac1ecf9d9f1cc16f3a0ff</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;WORKER BEE&quot;" target="&quot;DRONE&quot;">
      <data key="d4">5.0</data>
      <data key="d5">"Worker bees and drones have different roles; workers perform the majority of colony labor while the drone's role is critical but less daily-focused."</data>
      <data key="d6">chunk-78182a0a75dac1ecf9d9f1cc16f3a0ff</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;WORKER BEE&quot;" target="&quot;BROOD NEST&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Young worker bees begin their first duties in the heart of the brood nest."</data>
      <data key="d6">chunk-78182a0a75dac1ecf9d9f1cc16f3a0ff</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;WORKER BEE&quot;" target="&quot;HONEY BEE COLONY&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"Worker bees are the most populous members of the colony, performing all necessary labor for its survival."</data>
      <data key="d6">chunk-43e80ed5175459c22df05858f37cc067</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;WORKER BEE&quot;" target="&quot;METAMORPHOSIS&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"Worker bees facilitate metamorphosis by capping the cells where larvae develop."</data>
      <data key="d6">chunk-43e80ed5175459c22df05858f37cc067</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;QUEEN BEE&quot;" target="&quot;HIVE&quot;">
      <data key="d4">16.0</data>
      <data key="d5">"Once the queen begins laying eggs, she generally does not leave the hive."&lt;SEP&gt;"The queen bee resides in the hive, produces pheromones to communicate health throughout it, and lays eggs within it."</data>
      <data key="d6">chunk-14c389aa55b6d5b4c773f2c917b36e7a&lt;SEP&gt;chunk-43e80ed5175459c22df05858f37cc067</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;QUEEN BEE&quot;" target="&quot;DRONE BEE&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Drones spend their adult lives searching for a queen to mate with."</data>
      <data key="d6">chunk-14c389aa55b6d5b4c773f2c917b36e7a</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;QUEEN BEE&quot;" target="&quot;HONEY BEE COLONY&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"The queen bee is the largest member and the reproductive organ of the colony, laying eggs to ensure propagation."</data>
      <data key="d6">chunk-43e80ed5175459c22df05858f37cc067</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;QUEEN BEE&quot;" target="&quot;DRONE&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"Drones are responsible for mating with the queen to ensure fertilization and propagation of the species."</data>
      <data key="d6">chunk-43e80ed5175459c22df05858f37cc067</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;QUEEN BEE&quot;" target="&quot;METAMORPHOSIS&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The queen bee initiates the process by laying the eggs that undergo metamorphosis."</data>
      <data key="d6">chunk-43e80ed5175459c22df05858f37cc067</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;QUEEN BEE&quot;" target="&quot;SPLIT&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"A split may be created to allow bees to raise a new queen or may contain the original queen mother."</data>
      <data key="d6">chunk-99f3cfb348742cf36dd48849fb6973f6</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;QUEEN BEE&quot;" target="&quot;NUCLEUS COLONY&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"A nucleus colony is designed to either house a queen or be provided with resources to raise a new one."</data>
      <data key="d6">chunk-99f3cfb348742cf36dd48849fb6973f6</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;QUEEN BEE&quot;" target="&quot;WORKER BEES&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Worker bees are responsible for raising a new queen bee from eggs in the hive."</data>
      <data key="d6">chunk-99f3cfb348742cf36dd48849fb6973f6</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;QUEEN BEE&quot;" target="&quot;DRONE-LAYING QUEEN&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"A new queen's early egg-laying patterns can be confused with those of a drone-laying queen."</data>
      <data key="d6">chunk-99f3cfb348742cf36dd48849fb6973f6</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;QUEEN BEE&quot;" target="&quot;LAYING WORKER&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"A new queen's early egg-laying patterns can be confused with those of a laying worker."</data>
      <data key="d6">chunk-99f3cfb348742cf36dd48849fb6973f6</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;DRONE BEE&quot;" target="&quot;HIVE&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Drones spend their time alternating between flying to find a queen and resting in the hive; they are often forced out of the hive at the end of the season."</data>
      <data key="d6">chunk-14c389aa55b6d5b4c773f2c917b36e7a</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE&quot;" target="&quot;PACKAGE OF BEES&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The package of bees is installed into the hive, with frames removed from the hive to make space."</data>
      <data key="d6">chunk-3c3e0c4c99d600e81552689af79afdcd</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE&quot;" target="&quot;QUEEN CAGE&quot;">
      <data key="d4">18.0</data>
      <data key="d5">"The queen cage is hung inside the hive between two frames to facilitate the introduction of the queen."&lt;SEP&gt;"The queen cage is installed between frames inside the hive to introduce the queen."</data>
      <data key="d6">chunk-f6b1093c60c117041d669d3950218419&lt;SEP&gt;chunk-4ff7d8f22cb1bb72cdb48f20d4975e8d</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE&quot;" target="&quot;QUEEN&quot;">
      <data key="d4">17.0</data>
      <data key="d5">"The queen is installed into the hive and must be released to begin laying eggs to establish the colony."&lt;SEP&gt;"The queen is installed into the hive via a cage and eventually released to lead the colony."</data>
      <data key="d6">chunk-6706ffd7485284387c77b1f38a66ce9c&lt;SEP&gt;chunk-f6b1093c60c117041d669d3950218419</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE&quot;" target="&quot;FEEDER&quot;">
      <data key="d4">17.0</data>
      <data key="d5">"The feeder is a component of the hive assembly that is removed and refilled during inspections."&lt;SEP&gt;"The feeder is placed over the inner cover of the hive to provide syrup to the bees."</data>
      <data key="d6">chunk-f6b1093c60c117041d669d3950218419&lt;SEP&gt;chunk-4ff7d8f22cb1bb72cdb48f20d4975e8d</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE&quot;" target="&quot;PACKAGE CONTAINER&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The package container is used to transport bees and is shaken/poured directly over the hive during installation."</data>
      <data key="d6">chunk-f6b1093c60c117041d669d3950218419</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE&quot;" target="&quot;NUC&quot;">
      <data key="d4">17.0</data>
      <data key="d5">"A nuc is a smaller version of a hive body used for starting colonies."&lt;SEP&gt;"A nuc is transferred into a hive by placing its frames in the center of the hive."</data>
      <data key="d6">chunk-caeb5d2bd49a72e7116025708c05e9f6&lt;SEP&gt;chunk-6706ffd7485284387c77b1f38a66ce9c</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE&quot;" target="&quot;PACKAGE&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"A package of bees is installed into a hive to start a new colony."</data>
      <data key="d6">chunk-6706ffd7485284387c77b1f38a66ce9c</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE&quot;" target="&quot;FOUNDATION&quot;">
      <data key="d4">15.0</data>
      <data key="d5">"Foundation is the base upon which bees draw comb within the hive; it may be replaced if wild comb is not removed."&lt;SEP&gt;"The bees in the hive draw out the foundation to create comb."</data>
      <data key="d6">chunk-b902e3da084c9ce16ad8c497c00c21e2&lt;SEP&gt;chunk-4ff7d8f22cb1bb72cdb48f20d4975e8d</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE&quot;" target="&quot;CANDY&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"The candy is placed within the hive (inside the cage) as part of the queen installation process."</data>
      <data key="d6">chunk-4ff7d8f22cb1bb72cdb48f20d4975e8d</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE&quot;" target="&quot;SUPER&quot;">
      <data key="d4">27.0</data>
      <data key="d5">"An exceptionally heavy hive suggests the need for a super to provide extra space for honey."&lt;SEP&gt;"Supers are additional boxes placed on top of or within the hive body to expand space."&lt;SEP&gt;"Supers are components of the hive used for honey storage and are removed from the hive during honey harvest."</data>
      <data key="d6">chunk-0385df8773cab416fd9b294da95cf91d&lt;SEP&gt;chunk-b902e3da084c9ce16ad8c497c00c21e2&lt;SEP&gt;chunk-caeb5d2bd49a72e7116025708c05e9f6</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE&quot;" target="&quot;HIVE BODY&quot;">
      <data key="d4">18.0</data>
      <data key="d5">"The hive body is the main part of a hive containing the brood."&lt;SEP&gt;"The hive consists of hive bodies which contain frames and house the colony."</data>
      <data key="d6">chunk-67600081c317292f8ef362e2f5621f34&lt;SEP&gt;chunk-b902e3da084c9ce16ad8c497c00c21e2</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE&quot;" target="&quot;BROOD NEST&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The brood nest is located within the hive and its expansion indicates population growth."</data>
      <data key="d6">chunk-b902e3da084c9ce16ad8c497c00c21e2</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE&quot;" target="&quot;POLLEN&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Pollen is stored on frames within the hive as a food reserve."</data>
      <data key="d6">chunk-b30dd2b72067de8dc8358baf75e16d21</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE&quot;" target="&quot;TOP FEEDER&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The top feeder is a gallon jug placed on top of the hive."</data>
      <data key="d6">chunk-3646f7feb4b27315450c6eb80594e753</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE&quot;" target="&quot;BEE BRUSH&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"The bee brush is used during the process of removing supers from the hive."</data>
      <data key="d6">chunk-0385df8773cab416fd9b294da95cf91d</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE&quot;" target="&quot;DRONE&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Drones reside in the hive and serve roles that ensure the colony's survival."</data>
      <data key="d6">chunk-43e80ed5175459c22df05858f37cc067</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE&quot;" target="&quot;METAMORPHOSIS&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Metamorphosis occurs within the cells of the hive as larvae develop into adult bees."</data>
      <data key="d6">chunk-43e80ed5175459c22df05858f37cc067</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE&quot;" target="&quot;REVERSING&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Reversing involves restacking the boxes that make up the hive to change the position of the brood and honey."</data>
      <data key="d6">chunk-c516e184f72cae24cee188c702d41f00</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE&quot;" target="&quot;HONEY BEES&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"Honey bees live and work within the hive, utilizing brood areas and storing honey."</data>
      <data key="d6">chunk-c516e184f72cae24cee188c702d41f00</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE&quot;" target="&quot;BEEKEEPING&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"Beekeeping involves the management and maintenance of the hive and the bee colony within it."</data>
      <data key="d6">chunk-caeb5d2bd49a72e7116025708c05e9f6</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE&quot;" target="&quot;WAX MOTH&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Wax moths infest hives, laying eggs in dark crevices and larvae chewing into wooden parts of the hive."</data>
      <data key="d6">chunk-0f4bb80b935e118383082352a101ac3c</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE&quot;" target="&quot;SUPERS&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Supers are additions to the hive used for honey storage and are placed above the inner cover."</data>
      <data key="d6">chunk-0f4bb80b935e118383082352a101ac3c</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE&quot;" target="&quot;INNER COVER&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The inner cover is a specific component used in the construction of a hive."</data>
      <data key="d6">chunk-67600081c317292f8ef362e2f5621f34</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE&quot;" target="&quot;HONEY SUPER&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The honey super is a box used for honey production that is part of the hive structure."</data>
      <data key="d6">chunk-67600081c317292f8ef362e2f5621f34</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE&quot;" target="&quot;KENYAN TOP BAR HIVE&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The Kenyan Top Bar Hive is a specific style of hive."</data>
      <data key="d6">chunk-67600081c317292f8ef362e2f5621f34</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE&quot;" target="&quot;MEDIUM SUPER&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The medium super is a specific type of box used within a hive to store honey or raise brood."</data>
      <data key="d6">chunk-67600081c317292f8ef362e2f5621f34</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIVE&quot;" target="&quot;MIGRATORY BEEKEEPERS&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Migratory beekeepers move hives to different locations for pollination or honey flow."</data>
      <data key="d6">chunk-67600081c317292f8ef362e2f5621f34</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;COLONY&quot;" target="&quot;HONEY BEES&quot;">
      <data key="d4">19.0</data>
      <data key="d5">"Honey bees function both as individuals and as an entire colony."&lt;SEP&gt;"The colony consists of honey bees, and its population cycle is defined by the birth and death rates of individual bees."</data>
      <data key="d6">chunk-78182a0a75dac1ecf9d9f1cc16f3a0ff&lt;SEP&gt;chunk-651bdc43ce4f434b1e5c689b3528db55</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;COLONY&quot;" target="&quot;QUEEN&quot;">
      <data key="d4">18.0</data>
      <data key="d5">"The queen is a central member of the colony responsible for laying eggs to maintain and grow the population."&lt;SEP&gt;"The queen is a critical component of the colony's population and health; her egg-laying determines colony growth."</data>
      <data key="d6">chunk-349ce4585e93cae4853e6da2e815c494&lt;SEP&gt;chunk-651bdc43ce4f434b1e5c689b3528db55</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;COLONY&quot;" target="&quot;SWARMING&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Swarming is the process of colony reproduction where a portion of the parent colony leaves to start a new colony."</data>
      <data key="d6">chunk-651bdc43ce4f434b1e5c689b3528db55</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;COLONY&quot;" target="&quot;SUMMER SOLSTICE&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The colony's population typically reaches its maximum numbers around the time of the summer solstice."</data>
      <data key="d6">chunk-651bdc43ce4f434b1e5c689b3528db55</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;COLONY&quot;" target="&quot;BEEKEEPING&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Beekeeping involves the management of colonies, including the control of swarming and the collection of honey."</data>
      <data key="d6">chunk-651bdc43ce4f434b1e5c689b3528db55</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;COLONY&quot;" target="&quot;AMERICAN FOUL-BROOD&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"American foul-brood is a disease that affects the health of the colony."</data>
      <data key="d6">chunk-349ce4585e93cae4853e6da2e815c494</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;COLONY&quot;" target="&quot;NOSEMA DISEASE&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Nosema disease is an illness that bees in a colony are susceptible to, potentially requiring medication."</data>
      <data key="d6">chunk-349ce4585e93cae4853e6da2e815c494</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;COLONY&quot;" target="&quot;TRACHEAL MITES&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Tracheal mites are parasites that can compromise the health of the colony."</data>
      <data key="d6">chunk-349ce4585e93cae4853e6da2e815c494</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;COLONY&quot;" target="&quot;VARROA MITES&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Varroa mites are parasites that the beekeeper must monitor and potentially medicate against to protect the colony."</data>
      <data key="d6">chunk-349ce4585e93cae4853e6da2e815c494</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;COLONY&quot;" target="&quot;BEE VENOM THERAPY&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The author asks the colony to give up a part of its body (bees) to be used for bee venom therapy."</data>
      <data key="d6">chunk-d689db19e9533ba99ddacc008292886b</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PROPOLIS&quot;" target="&quot;BEE SUIT&quot;">
      <data key="d4">3.0</data>
      <data key="d5">"Propolis is a substance that may glue down hive covers, requiring a physical action to remove, while the bee suit is the attire worn by the person performing that action."</data>
      <data key="d6">chunk-7f35b518c8481093038a38bf2b64387d</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PROPOLIS&quot;" target="&quot;BEEKEEPING&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Propolis is one of the five hive products beekeepers may be questioned about or collect."</data>
      <data key="d6">chunk-b652e467f32b1db6fbb1cf5b9315586e</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PROPOLIS&quot;" target="&quot;APITHERAPY&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Propolis is a product of the hive covered under the collective term of apitherapy."</data>
      <data key="d6">chunk-b652e467f32b1db6fbb1cf5b9315586e</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PROPOLIS&quot;" target="&quot;HONEY BEES&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Propolis is a resinous substance collected by honey bees from plants to seal hive cracks and strengthen brood comb."</data>
      <data key="d6">chunk-b71c661e88d96156e87449e9332b56ce</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PROPOLIS&quot;" target="&quot;MICE&quot;">
      <data key="d4">5.0</data>
      <data key="d5">"Bees may embalm a dead mouse with propolis after attacking and killing it."</data>
      <data key="d6">chunk-6f9390615c59b7685e5899983f69d846</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PROPOLIS&quot;" target="&quot;BEE EQUIPMENT&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Propolis is used by bees to coat the interior of the equipment and can be used by humans as a varnish."</data>
      <data key="d6">chunk-58530be97ce8bec48257c2ee46f928b4</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PROPOLIS&quot;" target="&quot;STICKY PAPER TRAP&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Bees tend to fill the slits of the sticky paper trap with propolis, which can decrease the trap's effectiveness."</data>
      <data key="d6">chunk-5cdc449839e793310ef8f89b87479c09</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HONEY BEES&quot;" target="&quot;ANTHROPOMORPHISM&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Anthropomorphism is described as a tool used by humans to interpret and discuss honey bee behavior, though the text clarifies bees do not actually possess human traits."</data>
      <data key="d6">chunk-63d47730064116b6f4fe93ddb307901d</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HONEY BEES&quot;" target="&quot;INTELLIGENCE&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The text explicitly states that if intelligence is defined as the ability to reason and think abstractly, honey bees do not have it."</data>
      <data key="d6">chunk-63d47730064116b6f4fe93ddb307901d</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HONEY BEES&quot;" target="&quot;LEARNING&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Honey bees are described as capable of learning because their behavior can be modified by experience, such as associating food with odor."</data>
      <data key="d6">chunk-63d47730064116b6f4fe93ddb307901d</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HONEY BEES&quot;" target="&quot;QUEEN&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The queen lays the eggs from which new honey bees emerge."</data>
      <data key="d6">chunk-651bdc43ce4f434b1e5c689b3528db55</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HONEY BEES&quot;" target="&quot;BEEKEEPING&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"Beekeeping is the practice of keeping and managing honey bees."</data>
      <data key="d6">chunk-0a230cf3f43e673f8797237bc5d97548</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HONEY BEES&quot;" target="&quot;BEE VENOM&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Bee venom is produced by honey bees and is collected for medical use, often utilizing live bees for injection."</data>
      <data key="d6">chunk-b71c661e88d96156e87449e9332b56ce</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HONEY BEES&quot;" target="&quot;AMERICAN FOULBROOD&quot;">
      <data key="d4">18.0</data>
      <data key="d5">"American foulbrood is a devastating brood disease caused by bacteria that can kill entire honey bee colonies."&lt;SEP&gt;"American foulbrood is listed as a disease/condition affecting honey bees."</data>
      <data key="d6">chunk-b71c661e88d96156e87449e9332b56ce&lt;SEP&gt;chunk-ee2dbfbb5c1a5664034bad31b4143c62</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HONEY BEES&quot;" target="&quot;STATE APIARY INSPECTOR&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The state apiary inspector is a resource beekeepers contact to diagnose conditions or diseases in honey bee hives."</data>
      <data key="d6">chunk-b71c661e88d96156e87449e9332b56ce</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HONEY BEES&quot;" target="&quot;EUROPEAN FOULBROOD (EFB)&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"European foulbrood is listed as a disease/condition affecting honey bees."</data>
      <data key="d6">chunk-ee2dbfbb5c1a5664034bad31b4143c62</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HONEY BEES&quot;" target="&quot;NOSEMA DISEASE&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Nosema disease is a health condition associated with honey bees."</data>
      <data key="d6">chunk-ee2dbfbb5c1a5664034bad31b4143c62</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HONEY BEES&quot;" target="&quot;PORTER BEE&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The Porter bee escape is a specialized piece of equipment used within honey bee hives."</data>
      <data key="d6">chunk-ee2dbfbb5c1a5664034bad31b4143c62</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HONEY BEES&quot;" target="&quot;TERRAMYCIN&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Terramycin is a medication used to treat infections in honey bees."</data>
      <data key="d6">chunk-ee2dbfbb5c1a5664034bad31b4143c62</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HONEY BEES&quot;" target="&quot;MITICUR/AMITRAZ&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Miticur/Amitraz is used to treat varroa and tracheal mites in honey bees."</data>
      <data key="d6">chunk-ee2dbfbb5c1a5664034bad31b4143c62</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HONEY BEES&quot;" target="&quot;PARADICHLOROBENZINE (PDB)&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"Paradichlorobenzine is listed as a chemical treatment/insecticide used in honey bee management."</data>
      <data key="d6">chunk-ee2dbfbb5c1a5664034bad31b4143c62</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HONEY BEES&quot;" target="&quot;SMOKE&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"Smoke is used to confuse, distract, and disrupt the communication of honey bees to make beekeeping safer."</data>
      <data key="d6">chunk-c6739d4c7c92b4bbf50b18187fe06b72</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HONEY BEES&quot;" target="&quot;ORGANIC STANDARDS&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Organic standards prohibit the exploitative treatment of honey bees, such as removing too much honey."</data>
      <data key="d6">chunk-c6739d4c7c92b4bbf50b18187fe06b72</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HONEY BEES&quot;" target="&quot;CORPORATE AMERICA&quot;">
      <data key="d4">5.0</data>
      <data key="d5">"The author draws a parallel between Corporate America's history of limiting worker unity and the use of smoke to prevent honey bees from organizing in force."</data>
      <data key="d6">chunk-c6739d4c7c92b4bbf50b18187fe06b72</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HONEY BEES&quot;" target="&quot;TBH&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"TBH is a specific style of hive used to house and keep honey bees."</data>
      <data key="d6">chunk-8e06b0074dff6e9083043d922831e71f</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;ANTHROPOMORPHISM&quot;" target="&quot;SERENGETI&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"The author uses the example of wildebeests on the Serengeti to debunk anthropomorphic misunderstandings about herding behavior."</data>
      <data key="d6">chunk-4d55b538adad3c639b729e3377b78a20</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;ANTHROPOMORPHISM&quot;" target="&quot;TILLAGE&quot;">
      <data key="d4">5.0</data>
      <data key="d5">"The text discusses how the desire to remove cows (often driven by anthropomorphic views) leads to a reliance on unsustainable tillage systems."</data>
      <data key="d6">chunk-4d55b538adad3c639b729e3377b78a20</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;INTELLIGENCE&quot;" target="&quot;LEARNING&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The text distinguishes between the two, stating that while bees can learn, the ability to learn is not the same as intelligence."</data>
      <data key="d6">chunk-63d47730064116b6f4fe93ddb307901d</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;DRONE&quot;" target="&quot;HONEY BEE COLONY&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Drones are the male members of the colony, making up a small percentage of the population."</data>
      <data key="d6">chunk-43e80ed5175459c22df05858f37cc067</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;DRONE&quot;" target="&quot;DRONE BROOD&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"Drone brood is the immature stage of the Drone (male honey bee)."</data>
      <data key="d6">chunk-a44dc74bf3cf27c95be223e2ae38c2f2</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;DRONE&quot;" target="&quot;DRONE LAYER&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"A drone layer is a queen or worker bee that produces eggs which develop specifically into drones."</data>
      <data key="d6">chunk-a44dc74bf3cf27c95be223e2ae38c2f2</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;QUEEN&quot;" target="&quot;SWARMING&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"During swarming, the queen leaves the parent colony with about half of the bees to establish a new colony."</data>
      <data key="d6">chunk-ee196747c63e46006af016f7f2104f8d</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;QUEEN&quot;" target="&quot;WORKERS&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Workers control the queen's egg-laying rate through stimulation and feeding, and they harass her to get her into 'flying trim' before a swarm."</data>
      <data key="d6">chunk-ee196747c63e46006af016f7f2104f8d</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;QUEEN&quot;" target="&quot;BEE COLONY&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The queen gives off an odor that signals her presence to the colony at large."</data>
      <data key="d6">chunk-6f51ec44f0c17ad5253b21395cf12591</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;QUEEN&quot;" target="&quot;QUEEN CAGE&quot;">
      <data key="d4">29.0</data>
      <data key="d5">"A queen cage is a small box used to hold and transport a queen bee."&lt;SEP&gt;"The queen cage contains the queen, protecting her and providing a means for delayed release."&lt;SEP&gt;"The queen cage is the container used to hold and protect the queen during transport and installation."</data>
      <data key="d6">chunk-9654edf0284987ba4f0c8bde4acffe9b&lt;SEP&gt;chunk-f6b1093c60c117041d669d3950218419&lt;SEP&gt;chunk-3c3e0c4c99d600e81552689af79afdcd</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;QUEEN&quot;" target="&quot;WORKER BEES&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Worker bees in the queen cage act as attendants, grooming and feeding the queen."</data>
      <data key="d6">chunk-3c3e0c4c99d600e81552689af79afdcd</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;QUEEN&quot;" target="&quot;SUPPLIER&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The supplier provides the queen and is responsible for providing a replacement if the queen is found dead."</data>
      <data key="d6">chunk-3c3e0c4c99d600e81552689af79afdcd</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;QUEEN&quot;" target="&quot;NUC&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The nuc includes a queen who is either already on the frames or installed separately."</data>
      <data key="d6">chunk-6706ffd7485284387c77b1f38a66ce9c</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;QUEEN&quot;" target="&quot;PACKAGE&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"A package contains a mass of bees and a separate, young, mated queen in her own cage."</data>
      <data key="d6">chunk-6706ffd7485284387c77b1f38a66ce9c</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;QUEEN&quot;" target="&quot;BROOD NEST&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The queen lays eggs in a pattern that forms the brood nest."</data>
      <data key="d6">chunk-b902e3da084c9ce16ad8c497c00c21e2</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;QUEEN&quot;" target="&quot;WINTER&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The queen's egg-laying cycle is affected by winter, involving a vacation period followed by a resumption of brood raising."</data>
      <data key="d6">chunk-96d3190b056360cfac9d6ae0c079078e</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;QUEEN&quot;" target="&quot;HONEY BEE COLONY&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"The queen is a central member of the honey bee colony, responsible for reproduction and egg-laying."</data>
      <data key="d6">chunk-b481828497c05f9df552dd81b644f543</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;QUEEN&quot;" target="&quot;DRONES&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Drones provide the male DNA necessary for the queen during mating flights."</data>
      <data key="d6">chunk-b481828497c05f9df552dd81b644f543</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;QUEEN&quot;" target="&quot;PIPING&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Piping is a sound emitted by a queen bee, often representing a challenge to other queens in the hive."</data>
      <data key="d6">chunk-9654edf0284987ba4f0c8bde4acffe9b</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;QUEEN&quot;" target="&quot;PUSH-IN CAGE&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"A push-in cage allows a queen to lay eggs while remaining separated from the rest of the hive."</data>
      <data key="d6">chunk-9654edf0284987ba4f0c8bde4acffe9b</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;QUEEN&quot;" target="&quot;QUEEN CELL&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"A queen cell is the specific cell in which a queen bee develops from egg to adult."</data>
      <data key="d6">chunk-9654edf0284987ba4f0c8bde4acffe9b</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THE COLONY&quot;" target="&quot;INSECTICIDE&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Insecticides can cause massive disruptions in colony life by wiping out the foraging force or killing young bees."</data>
      <data key="d6">chunk-65de87b95deadb72c4827d5a3bd2f316</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THE COLONY&quot;" target="&quot;PHEROMONES&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The status and needs of the colony are signaled through the presence or absence of pheromones given off by adults and brood."</data>
      <data key="d6">chunk-65de87b95deadb72c4827d5a3bd2f316</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THE COLONY&quot;" target="&quot;NORTH AMERICA&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"The population cycle of a honey bee colony is represented for much of North America."</data>
      <data key="d6">chunk-65de87b95deadb72c4827d5a3bd2f316</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THE COLONY&quot;" target="&quot;THE DANCE LANGUAGE&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"The dance language is critical to the success, resource exploitation, and protection of the bee colony."</data>
      <data key="d6">chunk-3ca6767b0793c7530226a6b224d0f21b</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THE COLONY&quot;" target="&quot;RESEARCHERS&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Researchers monitored a specific colony in a deciduous forest for an entire summer to study its behavior."</data>
      <data key="d6">chunk-3ca6767b0793c7530226a6b224d0f21b</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THE COLONY&quot;" target="&quot;HIVE BODY&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"The colony occupies and draws out frames within the hive bodies, which serve as their primary living and storage space."</data>
      <data key="d6">chunk-a2b5f69931d3a60795392f1cd07c4c3a</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THE COLONY&quot;" target="&quot;BOARDMAN FEEDER&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The colony may be fed using a Boardman feeder, although the feeder can attract robber bees to the colony."</data>
      <data key="d6">chunk-a2b5f69931d3a60795392f1cd07c4c3a</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THE COLONY&quot;" target="&quot;ENTRANCE REDUCER&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"An entrance reducer is used to protect the colony from robber bees, especially when a Boardman feeder is present."</data>
      <data key="d6">chunk-a2b5f69931d3a60795392f1cd07c4c3a</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THE COLONY&quot;" target="&quot;SUPER&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"Supers can be used as an alternative to a hive body to hold a feeder jar for the colony."</data>
      <data key="d6">chunk-a2b5f69931d3a60795392f1cd07c4c3a</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;THE COLONY&quot;" target="&quot;GROWTH CURVE&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The growth curve is used as a basis for comparison to monitor the population increase and overall health of the colony."</data>
      <data key="d6">chunk-a2b5f69931d3a60795392f1cd07c4c3a</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PHEROMONES&quot;" target="&quot;DANCE LANGUAGE&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Both pheromones and dance language are the primary means by which honey bees communicate information."</data>
      <data key="d6">chunk-824704426592ed72e9ae44a04bd1ddbd</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PHEROMONES&quot;" target="&quot;BEE COLONY&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Pheromones govern many aspects of a bee's life and are associated with most colony activities."</data>
      <data key="d6">chunk-6f51ec44f0c17ad5253b21395cf12591</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PHEROMONES&quot;" target="&quot;BEETLE BLASTER&quot;">
      <data key="d4">3.0</data>
      <data key="d5">"Both are mentioned as different mechanisms for the control of small hive beetles."</data>
      <data key="d6">chunk-9fce1495ba322c9e7eb5acd1c4069cdf</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SWARMING&quot;" target="&quot;BEEKEEPING&quot;">
      <data key="d4">18.0</data>
      <data key="d5">"Swarming is a specific biological process and management challenge within the practice of beekeeping."&lt;SEP&gt;"Swarming is described as a fact of beekeeping life that requires management and control by the beekeeper."</data>
      <data key="d6">chunk-1205bbac28347dacca693957c5262ae4&lt;SEP&gt;chunk-651bdc43ce4f434b1e5c689b3528db55</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SWARMING&quot;" target="&quot;WORKERS&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Workers trigger the swarming process by reducing feeding of the queen and eventually harassing her to prepare her for flight."</data>
      <data key="d6">chunk-ee196747c63e46006af016f7f2104f8d</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SWARMING&quot;" target="&quot;SWARM CONTROL&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Swarm control involves understanding the swarming process and applying hive management techniques to prevent it."</data>
      <data key="d6">chunk-ee196747c63e46006af016f7f2104f8d</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SWARMING&quot;" target="&quot;REVERSING&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Reversing is a technique used by beekeepers to reduce a colony's swarming impulse."</data>
      <data key="d6">chunk-c516e184f72cae24cee188c702d41f00</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SWARMING&quot;" target="&quot;ALICE ECKLES&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"ALICE ECKLES provided the photo for Figure 3-36, which depicts swarms of bees."</data>
      <data key="d6">chunk-1205bbac28347dacca693957c5262ae4</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SWARMING&quot;" target="&quot;BEKEEPER&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Beekeepers monitor and manage hives to reduce the tendency to swarm, though they recognize it as a sign of a healthy colony."</data>
      <data key="d6">chunk-f2e066e2a68f225f5ecf3fa2f5d02bd8</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;WORKERS&quot;" target="&quot;HONEY BEE COLONY&quot;">
      <data key="d4">10.0</data>
      <data key="d5">"Workers are the primary laborers of the colony, responsible for foraging, nursing, and maintaining the hive."</data>
      <data key="d6">chunk-b481828497c05f9df552dd81b644f543</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;WORKERS&quot;" target="&quot;DRONES&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Workers cannibalize drone larvae and eggs during times of nutritional scarcity to conserve resources for the colony."</data>
      <data key="d6">chunk-b481828497c05f9df552dd81b644f543</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;BEE BIOLOGY&quot;" target="&quot;BEEKEEPING&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The text states that to correctly understand swarm control and prevention in beekeeping, one must understand bee biology."</data>
      <data key="d6">chunk-64bd868f29e83effc96703b72e21cc18</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;BEE BIOLOGY&quot;" target="&quot;BEEKEEPING COMMUNITY&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Increased knowledge of bee biology has allowed the beekeeping community to understand, keep, and manage bees more effectively."</data>
      <data key="d6">chunk-d711f27560f7987b017b85fa9c8a2e56</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;NECTAR&quot;" target="&quot;SUCROSE&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Sucrose is a principal sugar component of nectar that bees collect."</data>
      <data key="d6">chunk-64bd868f29e83effc96703b72e21cc18</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;NECTAR&quot;" target="&quot;GLUCOSE&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Bees invert the sucrose in nectar to yield glucose."</data>
      <data key="d6">chunk-64bd868f29e83effc96703b72e21cc18</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;NECTAR&quot;" target="&quot;FRUCTOSE&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Bees invert the sucrose in nectar to yield fructose."</data>
      <data key="d6">chunk-64bd868f29e83effc96703b72e21cc18</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;POLLEN&quot;" target="&quot;VITAMINS&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Pollen has an exceptionally high vitamin content."</data>
      <data key="d6">chunk-824704426592ed72e9ae44a04bd1ddbd</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;POLLEN&quot;" target="&quot;MINERALS&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Minerals are collected routinely as a part of pollen."</data>
      <data key="d6">chunk-824704426592ed72e9ae44a04bd1ddbd</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;POLLEN&quot;" target="&quot;FATS&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Fat for day-to-day use is available from pollen."</data>
      <data key="d6">chunk-824704426592ed72e9ae44a04bd1ddbd</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;POLLEN&quot;" target="&quot;POLLEN SUBSTITUTE&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Both pure pollen and pollen substitute are forms of protein that may be fed to bees."</data>
      <data key="d6">chunk-824704426592ed72e9ae44a04bd1ddbd</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;POLLEN&quot;" target="&quot;POLLEN SUPPLEMENT&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"A pollen supplement is a mixture of pure bee-collected pollen and pollen substitute."</data>
      <data key="d6">chunk-824704426592ed72e9ae44a04bd1ddbd</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;POLLEN&quot;" target="&quot;BEEKEEPING&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Pollen is collected from the hive by beekeepers for bee feed or sale as a health supplement."</data>
      <data key="d6">chunk-b652e467f32b1db6fbb1cf5b9315586e</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;POLLEN&quot;" target="&quot;APITHERAPY&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Pollen is a product of the hive covered under the collective term of apitherapy."</data>
      <data key="d6">chunk-b652e467f32b1db6fbb1cf5b9315586e</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SUCROSE&quot;" target="&quot;GLUCOSE&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Sucrose is inverted by bees to produce glucose."</data>
      <data key="d6">chunk-64bd868f29e83effc96703b72e21cc18</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SUCROSE&quot;" target="&quot;FRUCTOSE&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Sucrose is inverted by bees to produce fructose."</data>
      <data key="d6">chunk-64bd868f29e83effc96703b72e21cc18</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;FATS&quot;" target="&quot;SUGAR&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"Fat bodies in honey bees are developed primarily from sugar, not from pollen."</data>
      <data key="d6">chunk-824704426592ed72e9ae44a04bd1ddbd</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;FATS&quot;" target="&quot;CARBON-DIOXIDE&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Carbon-dioxide is a raw material assimilated by the plant to create organic compounds, including fats."</data>
      <data key="d6">chunk-3cbbf08936e127d696a15794ccea1707</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SUGAR&quot;" target="&quot;GRANULATED SUGAR&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Granulated sugar is one of the two acceptable forms of sugar for feeding bees."</data>
      <data key="d6">chunk-824704426592ed72e9ae44a04bd1ddbd</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SUGAR&quot;" target="&quot;HIGH-FRUCTOSE CORN SYRUP&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"High-fructose corn syrup is one of the two acceptable forms of sugar for feeding bees."</data>
      <data key="d6">chunk-824704426592ed72e9ae44a04bd1ddbd</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SUGAR&quot;" target="&quot;AGRICULTURE&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Sugar is a carbohydrate derived from crops produced within the agriculture industry."</data>
      <data key="d6" />
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIGH-FRUCTOSE CORN SYRUP&quot;" target="&quot;HMF&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Feed made from high-fructose corn syrup may contain HMF, which can weaken the vitality of the hive."</data>
      <data key="d6">chunk-d196d4416fd2851aefb4923ab8ddf3d4</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIGH-FRUCTOSE CORN SYRUP&quot;" target="&quot;BEEKEEPING INDUSTRY&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The beekeeping industry faces restrictions on HFCS due to organic standards and concerns over hive health."</data>
      <data key="d6">chunk-d196d4416fd2851aefb4923ab8ddf3d4</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIGH-FRUCTOSE CORN SYRUP&quot;" target="&quot;KING KORN&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"King Korn is a documentary that illustrates the complex, laboratory-like process required to produce high-fructose corn syrup."</data>
      <data key="d6">chunk-659bb35c94ac64eb362d6537bc347e37</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIGH-FRUCTOSE CORN SYRUP&quot;" target="&quot;EPIGENETICS&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Epigenetics is the science used to document the damage that high-fructose corn syrup causes to DNA and cells."</data>
      <data key="d6">chunk-659bb35c94ac64eb362d6537bc347e37</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIGH-FRUCTOSE CORN SYRUP&quot;" target="&quot;INDUSTRIAL FOOD SYSTEM&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The industrial food system produces high-fructose corn syrup, a substance that cannot be made in a home kitchen."</data>
      <data key="d6">chunk-659bb35c94ac64eb362d6537bc347e37</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HIGH-FRUCTOSE CORN SYRUP&quot;" target="&quot;GOVERNMENT&quot;">
