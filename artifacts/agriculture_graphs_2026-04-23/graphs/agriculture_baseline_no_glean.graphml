      <data key="d4">8.0</data>
      <data key="d5">"Information about local beekeeping associations can be obtained from the county extension office."</data>
      <data key="d6">chunk-759e701020a9c2cf1b1fc48ccd55df97</data>
      <data key="d7">1</data>
    </edge>
