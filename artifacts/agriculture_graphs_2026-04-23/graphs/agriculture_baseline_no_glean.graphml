      <data key="d4">9.0</data>
      <data key="d5">"Ficksburg is the location where experiments were conducted to analyze organic matter accumulation within the Union of South Africa."</data>
      <data key="d6">chunk-8675d7a54ed4060bc9313832d5f814a6</data>
      <data key="d7">1</data>
    </edge>
