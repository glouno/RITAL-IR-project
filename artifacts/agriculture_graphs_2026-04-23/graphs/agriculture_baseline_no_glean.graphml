      <data key="d6">chunk-81158f16b3cf87e12a53465738040b4b</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;REAL AMERICAN ETHICS&quot;" target="&quot;MORAL COMMODIFICATION&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"The book Real American Ethics defines moral commodification as transformations that reduce the richness of everyday life."</data>
      <data key="d6">chunk-81158f16b3cf87e12a53465738040b4b</data>
      <data key="d7">1</data>
    </edge>
