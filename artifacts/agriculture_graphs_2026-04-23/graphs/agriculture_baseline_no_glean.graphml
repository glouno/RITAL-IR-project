      <data key="d4">7.0</data>
      <data key="d5">"The county Extension office is a local manifestation of the broader Extension service providing soil and nutrient testing."</data>
      <data key="d6">chunk-43b1ee12a99c9b1b3ebd9a36f25d2a6f</data>
      <data key="d7">1</data>
    </edge>
