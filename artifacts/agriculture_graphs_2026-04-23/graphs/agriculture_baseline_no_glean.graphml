      <data key="d5">"The CRA uses regulatory approvals of GM corn to defend the safety of corn-based products."</data>
      <data key="d6">chunk-a78d99903600ffa6f92d29953bed6a52</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;NATIONAL HONEY BOARD&quot;" target="&quot;CLOSTRIDIUM BOTULINUM&quot;">
      <data key="d4">8.0</data>
