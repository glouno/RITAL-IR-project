      <data key="d6">chunk-b66ffae2696b4f9024085ef90af5320a</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SOUTH&quot;" target="&quot;ROUNDWORMS&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Roundworm parasites in sheep flourish in the South due to warm, humid weather."</data>
      <data key="d6">chunk-50ae2b642515d199b40d344346490776</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SOUTH&quot;" target="&quot;VANDERBILT AGRARIANS&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The Vanderbilt Agrarians wrote about the contrast between the urbanized/industrial North and the rural/agrarian South."</data>
      <data key="d6">chunk-e7387a4222a4874eee8b02d6dc3da850</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SOUTH&quot;" target="&quot;BRANDT REPORT&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"The Brandt Report focuses on southern dependency on northern industrialized economies."</data>
      <data key="d6">chunk-bec46d177c6336f2fe727e22398abaf6</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SOUTH&quot;" target="&quot;NORTH&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"North-South relations are characterized by the South's dependency on the North for markets and industrial products."</data>
      <data key="d6">chunk-bec46d177c6336f2fe727e22398abaf6</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SOUTH&quot;" target="&quot;BRUNDTLAND REPORT&quot;">
      <data key="d4">7.0</data>
      <data key="d5">"The Brundtland Report shifts away from claims of the South against the North toward a framework of common interests."</data>
      <data key="d6">chunk-bec46d177c6336f2fe727e22398abaf6</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;SOUTH&quot;" target="&quot;TOM LYSON&quot;">
