      <data key="d4">9.0</data>
      <data key="d5">"The health care system is described as unable to function properly until the broken food system is fixed."</data>
      <data key="d6">chunk-737fb05b56336a1f569d769f73394b31</data>
      <data key="d7">1</data>
    </edge>
