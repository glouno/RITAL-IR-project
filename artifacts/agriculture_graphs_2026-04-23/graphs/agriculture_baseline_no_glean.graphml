      <data key="d4">9.0</data>
      <data key="d5">"P. cystidiosus is a close ally and nearly identical species to P. abalonus, with some authors suggesting they may be conspecific."</data>
      <data key="d6">chunk-33ea2f9846e58f5947feff6e3a84d189</data>
      <data key="d7">1</data>
    </edge>
