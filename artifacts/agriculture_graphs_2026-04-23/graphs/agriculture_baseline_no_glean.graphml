      <data key="d6">chunk-11c852a940991461ca29b76becfe24a7</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;PETROLEUM&quot;" target="&quot;ORGANIC METHODS&quot;">
      <data key="d4">6.0</data>
      <data key="d5">"The text suggests avoiding chemically laden products derived from petroleum in favor of foods grown with organic methods."</data>
      <data key="d6">chunk-ba112c4310be31fc99e92db5c7bc7f59</data>
      <data key="d7">1</data>
    </edge>
