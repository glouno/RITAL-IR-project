      <data key="d4">9.0</data>
      <data key="d5">"Apistan is an approved treatment material used to kill or stun Varroa mites."</data>
      <data key="d6">chunk-940d85de3b7092a6c76b3ef360a50ea0</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;VARROA MITE&quot;" target="&quot;MITICUR&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Miticur is an approved treatment material used to treat Varroa mite infestations."</data>
      <data key="d6">chunk-940d85de3b7092a6c76b3ef360a50ea0</data>
      <data key="d7">1</data>
    </edge>
