      <data key="d4">7.0</data>
      <data key="d5">"P. cystidiosus shares great similarity with P. smithii and may be conspecific with it."</data>
      <data key="d6">chunk-33ea2f9846e58f5947feff6e3a84d189</data>
      <data key="d7">1</data>
    </edge>
