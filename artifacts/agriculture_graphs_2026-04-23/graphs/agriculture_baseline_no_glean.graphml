      <data key="d6">chunk-0a230cf3f43e673f8797237bc5d97548</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HONEY SUPERS&quot;" target="&quot;FRAMES&quot;">
      <data key="d4">9.0</data>
      <data key="d5">"Honey supers contain their own specific shallow or mid-depth frames."</data>
      <data key="d6">chunk-0a230cf3f43e673f8797237bc5d97548</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HONEY SUPERS&quot;" target="&quot;FOUNDATION&quot;">
      <data key="d4">8.0</data>
      <data key="d5">"Honey supers utilize specific shallow or mid-depth foundation."</data>
      <data key="d6">chunk-0a230cf3f43e673f8797237bc5d97548</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;HONEY SUPERS&quot;" target="&quot;PINE&quot;">
      <data key="d4">7.0</data>
