    <node id="&quot;ALAN HOLLAND&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Alan Holland is a scholar who argues that the difference between weak and strong sustainability is the difference between anthropocentric and ecocentric environmental philosophies."</data>
      <data key="d2">chunk-ddd79b341dfcb637bbc86f0265484513</data>
      <data key="d3">[{"level": 0, "cluster": 8}, {"level": 1, "cluster": 156}, {"level": 2, "cluster": 821}]</data>
