      <data key="d4">7.0</data>
      <data key="d5">"Dymond's work helps emancipate future investigators from the restrictive 'NPK mentality' by treating manuring as a biological problem."</data>
      <data key="d6">chunk-5ac72dfa70392b35da5b9538cf9d2202</data>
      <data key="d7">1</data>
    </edge>
