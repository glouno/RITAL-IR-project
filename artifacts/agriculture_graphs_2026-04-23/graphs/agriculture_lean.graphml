    <node id="&quot;CANADA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">Canada is a North American country characterized by its agrarian themes, including conservation agriculture, taxpayer-supported animal production, and a mushroom market that exports wild varieties to Europe. It is the location of Vancouver and the University of British Columbia, and it serves as a source of imported lumber and stock culture libraries.</data>
      <data key="d2">chunk-5780ec82bf5f9eace3f594f7e7368b9c&lt;SEP&gt;chunk-6c3e9b22256bd1fdb52e241a416095ab&lt;SEP&gt;chunk-8609577658e45ab0e2c17bf451f3b33b&lt;SEP&gt;chunk-b52b5200e77354191139029d689fb62d&lt;SEP&gt;chunk-99e4abb0de7b0941ca1fc87ecc8fb4fd&lt;SEP&gt;chunk-0c6f8753099a6779fea902d00492c19f&lt;SEP&gt;chunk-adc43a3f1c081aba3e143c209e36aef8&lt;SEP&gt;chunk-2f716dbb539b9e685559a05a8f9f5d54&lt;SEP&gt;chunk-49fe442094e7ea7c8e57a86dad17be24&lt;SEP&gt;chunk-27a20f78a3d55496e66f77ebe53b96a6&lt;SEP&gt;chunk-12c1e39a2b39311bfd6f1c3c05dab313&lt;SEP&gt;chunk-d30f323d641a1c5f22026b8b0bab6b32&lt;SEP&gt;chunk-54c5f82f0f44cdd87998f2211f5330e7&lt;SEP&gt;chunk-2a81a83856d7b7ec39448bc80f43b8fa&lt;SEP&gt;chunk-2b17b36bfa30ea43a4face81eab38ad2&lt;SEP&gt;chunk-e1b198fa71b44d8dd33dcfc2eb267be7&lt;SEP&gt;chunk-4ff2a1270133813dbf92927fcbf14a3c&lt;SEP&gt;chunk-e4b97dd6d6b95eae2e9e3d26bad764c5&lt;SEP&gt;chunk-a222f4d2ebac0805d7a35f6ea2281563&lt;SEP&gt;chunk-48779ccefd65e29504648e87fe948afa&lt;SEP&gt;chunk-25521141823b7becef820b71d7dbda0c&lt;SEP&gt;chunk-5fbe3628e117427ed1c35a791b026e9a&lt;SEP&gt;chunk-eddf2c11ae7d5f7c383adfd979b680d2&lt;SEP&gt;chunk-2bc219a87c7ecb22911c9b9083bd392f&lt;SEP&gt;chunk-75d231af67d93bdb8bdb190752047b68&lt;SEP&gt;chunk-7dbc1c2ec064a792c47e97c74d0a8614&lt;SEP&gt;chunk-f631071313bdef0aeb10a5956616bd17&lt;SEP&gt;chunk-408f6f0784b8ad7de477241c6ca88e5b&lt;SEP&gt;chunk-01d793c2dc61cc5608f3044cefea7d3c&lt;SEP&gt;chunk-a529b2a82aeedaec884d490e181507e6&lt;SEP&gt;chunk-bfc2a2ad2b38fdda540087364d1c8ae3&lt;SEP&gt;chunk-5a2c449f01571421e5d465367c2416a4&lt;SEP&gt;chunk-c69d184d39c4fc61b176c219e8852dce&lt;SEP&gt;chunk-a6ac3062e2f983be26233b2d2aaf916a&lt;SEP&gt;chunk-85284a23be3f49e6f94cd4e536e396a3&lt;SEP&gt;chunk-50ae2b642515d199b40d344346490776&lt;SEP&gt;chunk-1ba06576d3e50eb6533780747a29cf91&lt;SEP&gt;chunk-38b5915dc248e6ded7d55b74f484cddd&lt;SEP&gt;chunk-4455bd7c30235e62c66747849070cfae</data>
